+def sort_images_custom(images):
+    """
+    Sorts gallery photos according to specific user requirements:
+    1. FRONT.jpg / 1.jpg / 4.jpg first
+    2. Other mockups & bundles
+    3. detail.png (second to last)
+    4. thank you.png / rec.png (last)
+    """
+    img_front = []
+    img_4 = []
+    img_6 = []
+    img_printing = []
+    img_3 = []
+    img_independence = []
+    img_detail = []
+    img_thankyou = []
+    img_whatsapp = []
+    img_rec = []
+    img_others = []
+    
+    for path in images:
+        name = os.path.basename(path)
+        name_lower = name.lower()
+        
+        if name_lower == "front.jpg" or name_lower == "front.png" or name_lower == "1.jpg":
+            img_front.append(path)
+        elif "detail" in name_lower:
+            img_detail.append(path)
+        elif "thank" in name_lower:
+            img_thankyou.append(path)
+        elif name_lower == "4.jpg":
+            img_4.append(path)
+        elif name_lower == "6.jpg":
+            img_6.append(path)
+        elif "printing_poster_mockup" in name_lower:
+            img_printing.append(path)
+        elif name_lower == "3.jpg":
+            img_3.append(path)
+        elif "25_independence_day_wall_art_bundle" in name_lower:
+            img_independence.append(path)
+        elif name_lower == "rec.png":
+            img_rec.append(path)
+        elif "whatsapp" in name_lower:
+            img_whatsapp.append(path)
+        else:
+            img_others.append(path)
+            
+    img_printing.sort()
+    img_independence.sort()
+    img_others.sort()
+    
+    ordered = []
+    ordered.extend(img_front)
+    ordered.extend(img_4)
+    ordered.extend(img_6)
+    ordered.extend(img_printing)
+    ordered.extend(img_3)
+    ordered.extend(img_independence)
+    ordered.extend(img_others)
+    ordered.extend(img_whatsapp)
+    ordered.extend(img_detail)
+    ordered.extend(img_rec)
+    ordered.extend(img_thankyou)
+    
+    return ordered
