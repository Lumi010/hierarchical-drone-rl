--- /dev/null
+++ b/tv (3).jsx	
@@ -0,0 +1,254 @@
+// Photoshop Script (JSX) to automate TV and Frame mockup creation for multiple designs.
+// Uses the stable, memory-safe PSB editContents workflow (same as the vertical mockup script).
+//
+// Prompts the user to:
+//   1. Choose scaling mode (STRETCH vs COVER/ZOOM).
+//   2. Select multiple design files (JPG/JPEG/PNG).
+//   3. Select the folder containing PSD mockup templates.
+//   4. Select the destination folder for exporting finished mockups.
+//
+// Custom behavior:
+//   - Creates a design-specific subfolder for each selected design.
+//   - Files containing "3840" or "2160" (4K resolution files) are saved as a copy JPG at max quality (12).
+//   - All other files (normal mockups) are exported using "Save for Web / Export As" at "Great" quality (80%).
+
+#target photoshop
+
+main();
+
+function main() {
+    // ---- Step 1: Choose mode ----
+    var useStretch = confirm(
+        "Choose scaling mode:\n\n" +
+        "Click YES  ->  STRETCH\n" +
+        "   Fills frame exactly, slight distortion if ratios differ\n" +
+        "   Best for: Typography, text, bordered designs\n\n" +
+        "Click NO  ->  COVER / ZOOM\n" +
+        "   Zooms to fill, no distortion, slight edge crop\n" +
+        "   Best for: Illustrations, art, photos"
+    );
+    var modeName = useStretch ? "STRETCH" : "COVER/ZOOM";
+
+    // Define a cross-platform file filter (Windows uses string pattern, Mac uses function)
+    var filterFiles;
+    if (Folder.fs === "Windows") {
+        filterFiles = "JPEG/PNG Files: *.jpg;*.jpeg;*.png";
+    } else {
+        filterFiles = function(file) {
+            if (file instanceof Folder) return true;
+            var name = file.name.toLowerCase();
+            return (name.match(/\.(jpg|jpeg|png)$/i) !== null);
+        };
+    }
+
+    // ---- Step 2: Select multiple design files ----
+    var designFiles = File.openDialog(
+        "Select your design files (hold Ctrl to select multiple)  [Mode: " + modeName + "]",
+        filterFiles,
+        true
+    );
+    if (!designFiles) { alert("Cancelled."); return; }
+
+    // Normalise to always be an array
+    if (!(designFiles instanceof Array)) {
+        designFiles = [designFiles];
+    }
+
+    // ---- Step 3: Select mockup PSDs folder ----
+    var mockupFolder = Folder.selectDialog("Select the folder containing your PSD mockups:");
+    if (!mockupFolder) { alert("Cancelled."); return; }
+
+    // ---- Step 4: Select output folder ----
+    var outputFolder = Folder.selectDialog("Select OUTPUT folder (subfolders will be created per design):");
+    if (!outputFolder) { alert("Cancelled."); return; }
+    if (!outputFolder.exists) outputFolder.create();
+
+    var psdFiles = mockupFolder.getFiles("*.psd");
+    if (psdFiles.length === 0) { alert("No PSD files found in the selected mockup folder."); return; }
+
+    if (!confirm(
+        "Ready!\n\n" +
+        "Mode:     " + modeName + "\n" +
+        "Designs:  " + designFiles.length + "\n" +
+        "Mockups:  " + psdFiles.length + " PSDs\n" +
+        "Total:    " + (designFiles.length * psdFiles.length) + " JPGs\n\n" +
+        "Click OK to start."
+    )) {
+        alert("Cancelled.");
+        return;
+    }
+
+    var successCount = 0;
+    var errorLog    = [];
+
+    // Save original Photoshop ruler units and display settings
+    var originalRulerUnits = app.preferences.rulerUnits;
+    var originalDisplayDialogs = app.displayDialogs;
+    
+    app.preferences.rulerUnits = Units.PIXELS;
+    app.displayDialogs = DialogModes.NO; // Suppress warnings and settings prompts
+
+    // ---- Step 5: Loop through each design ----
+    for (var d = 0; d < designFiles.length; d++) {
+        var designFile = designFiles[d];
+        var designName = designFile.name.replace(/\.[^.]+$/, ""); // strip extension
+
+        // Create a subfolder for this design's mockups
+        var designOutFolder = new Folder(outputFolder.fsName + "/" + designName);
+        if (!designOutFolder.exists) designOutFolder.create();
+
+        // ---- Loop through each mockup PSD ----
+        for (var i = 0; i < psdFiles.length; i++) {
+            var doc = null;
+            var filename = psdFiles[i].name.toLowerCase();
+            var is4K = (filename.indexOf("3840") !== -1 || filename.indexOf("2160") !== -1);
+
+            // Dynamically set targetNames: do NOT search for "Layer 1" in normal templates
+            var targetNames = is4K 
+                ? ["Layer 1", "Place Your Design Here", "Your design here", "design"]
+                : ["Place Your Design Here", "Your design here", "design"];
+
+            try {
+                doc = open(psdFiles[i]);
+
+                // Find the smart object layer anywhere in the document
+                var smartObjectLayer = findLayerRecursive(doc, targetNames);
+
+                if (smartObjectLayer) {
+                    doc.activeLayer = smartObjectLayer;
+
+                    // Open the Smart Object PSB
+                    var idplacedLayerEditContents = stringIDToTypeID("placedLayerEditContents");
+                    executeAction(idplacedLayerEditContents, undefined, DialogModes.NO);
+
+                    var psbDoc = app.activeDocument;
+
+                    // Place the design into the Smart Object
+                    var desc = new ActionDescriptor();
+                    desc.putPath(charIDToTypeID("null"), designFile);
+                    executeAction(charIDToTypeID("Plc "), desc, DialogModes.NO);
+
+                    var placedLayer = psbDoc.activeLayer;
+                    var bounds      = placedLayer.bounds;
+                    var w           = bounds[2].value - bounds[0].value;
+                    var h           = bounds[3].value - bounds[1].value;
+
+                    var canvasW = psbDoc.width.value;
+                    var canvasH = psbDoc.height.value;
+
+                    // Scale based on chosen mode
+                    if (useStretch) {
+                        var scaleX = (canvasW / w) * 100;
+                        var scaleY = (canvasH / h) * 100;
+                        placedLayer.resize(scaleX, scaleY, AnchorPosition.MIDDLECENTER);
+                    } else {
+                        var scale = Math.max(canvasW / w, canvasH / h) * 100;
+                        placedLayer.resize(scale, scale, AnchorPosition.MIDDLECENTER);
+                    }
+
+                    // Center the design in the frame
+                    var newBounds = placedLayer.bounds;
+                    var newW      = newBounds[2].value - newBounds[0].value;
+                    var newH      = newBounds[3].value - newBounds[1].value;
+                    var deltaX    = (canvasW / 2) - (newBounds[0].value + newW / 2);
+                    var deltaY    = (canvasH / 2) - (newBounds[1].value + newH / 2);
+                    placedLayer.translate(deltaX, deltaY);
+
+                    // Remove old placeholder layers inside the Smart Object
+                    var layers = psbDoc.layers;
+                    for (var j = layers.length - 1; j >= 0; j--) {
+                        if (layers[j] !== placedLayer) {
+                            try { layers[j].remove(); } catch (e) {}
+                        }
+                    }
+
+                    // Save and close the Smart Object PSB
+                    psbDoc.close(SaveOptions.SAVECHANGES);
+
+                    // Export the mockup JPG → into this design's subfolder
+                    var jpgName = psdFiles[i].name.replace(/\.psd$/i, ".jpg");
+                    var jpgFile = new File(designOutFolder.fsName + "/" + jpgName);
+
+                    if (is4K) {
+                        // Max quality (12) save as copy for 4K resolution files
+                        var jpgSaveOptions = new JPEGSaveOptions();
+                        jpgSaveOptions.embedColorProfile = true;
+                        jpgSaveOptions.formatOptions     = FormatOptions.STANDARDBASELINE;
+                        jpgSaveOptions.matte             = MatteType.NONE;
+                        jpgSaveOptions.quality           = 12;
+                        
+                        doc.saveAs(jpgFile, jpgSaveOptions, true, Extension.LOWERCASE);
+                    } else {
+                        // Export As JPG with "Great" Quality (80%) for normal mockups
+                        var exportOptions = new ExportOptionsSaveForWeb();
+                        exportOptions.format = SaveDocumentType.JPEG;
+                        exportOptions.quality = 80;
+                        exportOptions.optimized = true;
+                        exportOptions.includeProfile = true; // Preserve color profile
+                        
+                        doc.exportDocument(jpgFile, ExportType.SAVEFORWEB, exportOptions);
+                    }
+
+                    successCount++;
+
+                } else {
+                    errorLog.push("Smart Object layer not found in: " + psdFiles[i].name);
+                }
+
+            } catch (e) {
+                errorLog.push("Error: " + designName + " + " + psdFiles[i].name + "\n  " + e.message);
+            }
+
+            // Close PSD without saving (keeps template clean for next design)
+            if (doc !== null) {
+                try { doc.close(SaveOptions.DONOTSAVECHANGES); } catch (e2) {}
+            }
+
+            // Purge and garbage collect after each file
+            $.gc();
+            try { app.purge(PurgeTarget.ALL); } catch (e) {}
+        }
+    }
+
+    // Restore original Photoshop preferences
+    app.preferences.rulerUnits = originalRulerUnits;
+    app.displayDialogs = originalDisplayDialogs;
+
+    // ---- Done ----
+    var msg = "DONE!\n\n" +
+        successCount + " mockup JPGs created.\n\n" +
+        "Output:\n" + outputFolder.fsName;
+    if (errorLog.length > 0) {
+        msg += "\n\nERRORS:\n" + errorLog.join("\n");
+    }
+    alert(msg);
+}
+
+// ============================================================
+// Find a layer by name anywhere in the document (recurses into groups)
+// Supports matching multiple name options
+// ============================================================
+function findLayerRecursive(parent, targetNames) {
+    for (var i = 0; i < parent.layers.length; i++) {
+        var layer = parent.layers[i];
+
+        // Check if layer matches any of the target names exactly
+        var isMatch = false;
+        for (var j = 0; j < targetNames.length; j++) {
+            if (layer.name.toLowerCase() === targetNames[j].toLowerCase()) {
+                isMatch = true;
+                break;
+            }
+        }
+
+        if (isMatch && layer.typename === "ArtLayer" && layer.kind === LayerKind.SMARTOBJECT) {
+            return layer;
+        }
+
+        if (layer.typename === "LayerSet") {
+            var found = findLayerRecursive(layer, targetNames);
+            if (found) return found;
+        }
+    }
+    return null;
+}
