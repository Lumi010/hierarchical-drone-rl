+def get_file_list(folder, extensions):
+    files = []
+    if os.path.exists(folder):
+        for f in os.listdir(folder):
+            if f.lower().endswith(extensions):
+                files.append(os.path.abspath(os.path.join(folder, f)))
+    return sorted(files)
