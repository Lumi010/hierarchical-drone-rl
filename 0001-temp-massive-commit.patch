+                if digital_files:
+                    digital_input.set_input_files(digital_files)
+                    print(f"Uploaded {len(digital_files)} digital resolution files.")
+                    time.sleep(8)
+            except Exception as e:
+                print(f"Print files upload warning: {e}")
+
+        # --- STEP 5: HOW IT'S MADE TAB ---
+        if go_to_tab(page, "How It's Made"):
+            print("Selecting production details...")
+            try:
+                page.locator("label:has-text('I did')").first.click(force=True)
+                time.sleep(0.5)
+                page.locator("label:has-text('A supply or tool to make things')").first.click(force=True)
+                time.sleep(0.5)
+                page.locator("select#when-made-select").select_option("2020_2026")
+                time.sleep(0.5)
+            except Exception as e:
+                print(f"Production info warning: {e}")
+
+            try:
+                page.locator("label:has-text('An AI generator')").first.click(force=True)
+            except Exception as e:
+                print(f"Tools check warning: {e}")
+
+        # --- STEP 6: SETTINGS & SAVE DRAFT ---
+        if go_to_tab(page, "Settings"):
+            try:
+                page.locator("label:has-text('Automatic')").first.click(force=True)
+            except Exception as e:
+                print(f"Settings warning: {e}")
+
+        print("Saving listing as Draft...")
+        try:
+            save_draft = page.locator("button:has-text('Save as draft'), button:has-text('Save as Draft')").first
+            save_draft.click()
+            print("Successfully saved listing as Draft!")
+        except Exception as e:
+            print(f"Save draft warning: {e}")
+
+        time.sleep(5)
+        print("Done!")
+        context.close()
+
+if __name__ == "__main__":
+    main()
