--- /dev/null
+++ b/MutedBloom_Master_Automator.jsx
@@ -0,0 +1,435 @@
+// ============================================================
+// MUTEDBLOOM MASTER AUTOMATION SCRIPT (Full Workflow Edition)
+// ============================================================
+//
+// CONFIGURATION: Set your template folder paths here once!
+// Use double backslashes (\\) on Windows.
+// ============================================================
+var RATIO_PSD_PATH     = "D:\\etsy\\Ratio psd";      // Folder containing your 5 template PSDs
+var MOCKUP_PSD_PATH    = "D:\\etsy\\Mocks new";      // Folder containing your mockup template PSDs
+var UPSCAYL_EXE_PATH   = "C:\\Program Files\\Upscayl\\resources\\bin\\upscayl-bin.exe";
+var UPSCAYL_MODEL_PATH = "C:\\Program Files\\Upscayl\\resources\\models";
+
+// ============================================================
+#target photoshop
+
+main();
+
+function main() {
+    app.displayDialogs = DialogModes.NO;
+
+    // ---- Step 1: Verify Pre-configured Folders exist ----
+    var ratioFolder = new Folder(RATIO_PSD_PATH);
+    var mockupFolder = new Folder(MOCKUP_PSD_PATH);
+    var upscaylExe = new File(UPSCAYL_EXE_PATH);
+
+    if (!ratioFolder.exists) {
+        alert("CONFIGURATION ERROR:\nRatio templates folder not found at:\n" + RATIO_PSD_PATH + "\n\nPlease open this script in a text editor and edit the path variables at the top.");
+        return;
+    }
+    if (!mockupFolder.exists) {
+        alert("CONFIGURATION ERROR:\nMockup templates folder not found at:\n" + MOCKUP_PSD_PATH + "\n\nPlease edit the path variables at the top of the script.");
+        return;
+    }
+    if (!upscaylExe.exists) {
+        alert("CONFIGURATION ERROR:\nUpscayl executable not found at:\n" + UPSCAYL_EXE_PATH + "\n\nPlease verify your Upscayl installation path.");
+        return;
+    }
+
+    // ---- Step 2: Choose Scaling Mode ----
+    var useStretch = confirm(
+        "MASTER AUTOMATOR  —  Choose scaling mode:\n\n" +
+        "Click YES  →  STRETCH\n" +
+        "   Fills frame exactly (slight distortion if ratios differ)\n" +
+        "   Best for: Typography, text, bordered designs\n\n" +
+        "Click NO  →  CROP / COVER / ZOOM\n" +
+        "   Zooms to fill frame, no distortion, slight edge crop\n" +
+        "   Best for: Illustrations, art, photos, designs with people"
+    );
+    var modeName = useStretch ? "STRETCH" : "CROP/ZOOM";
+
+    // ---- Step 3: Select Designs Folder ----
+    var designFolder = Folder.selectDialog(
+        "Select your folder containing original downloaded designs  [Mode: " + modeName + "]"
+    );
+    if (!designFolder) { alert("Cancelled."); return; }
+
+    var designFiles = getImageFiles(designFolder);
+    if (designFiles.length === 0) {
+        alert("No image files found in your designs folder!\nSupported: JPG, PNG, TIF, BMP");
+        return;
+    }
+
+    // Automatically set output and upscaled folders inside the selected designs folder
+    var outputFolder = new Folder(designFolder.fsName + "/output");
+    if (!outputFolder.exists) {
+        outputFolder.create();
+    }
+
+    var upscaledFolder = new Folder(designFolder.fsName + "/upscaled");
+    if (!upscaledFolder.exists) {
+        upscaledFolder.create();
+    }
+
+    if (!confirm(
+        "Workflow Plan:\n\n" +
+        "1. UPSCALE:  Upscayl " + designFiles.length + " designs to 6x (saves in 'upscaled' folder)\n" +
+        "2. EXPORT:   Generate 5 high-res ratio JPEGs per design\n" +
+        "3. MOCKUPS:  Generate mockup JPEGs per design\n\n" +
+        "Scaling Mode: " + modeName + "\n" +
+        "Output Folder: " + outputFolder.fsName + "\n\n" +
+        "Click OK to begin. Photoshop will freeze temporarily during upscaling."
+    )) {
+        alert("Cancelled.");
+        return;
+    }
+
+    // Execute Upscayl command line with -s 6 for 6x upscaling
+    var upscaylCmd = '"' + UPSCAYL_EXE_PATH + '" -i "' + designFolder.fsName + '" -o "' + upscaledFolder.fsName + '" -m "' + UPSCAYL_MODEL_PATH + '" -n upscayl-standard-4x -s 6 -f png';
+    
+    // app.system is a blocking call, waits until Upscayl finishes upscaling all files
+    app.system('cmd.exe /c "' + upscaylCmd + '"');
+
+    // Re-scan upscaled folder to check if files were generated successfully
+    var upscaledFiles = getImageFiles(upscaledFolder);
+    if (upscaledFiles.length === 0) {
+        alert("Upscaling failed or was cancelled. No files found in the upscaled folder.");
+        return;
+    }
+
+    var ratioFiles  = getPSDFiles(ratioFolder);
+    var mockupFiles = getPSDFiles(mockupFolder);
+
+    // Save original ruler units
+    var originalRulerUnits = app.preferences.rulerUnits;
+    app.preferences.rulerUnits = Units.PIXELS;
+
+    var successCount = 0;
+    var errorLog    = [];
+
+    // ---- Step 5: Process each design ----
+    for (var d = 0; d < designFiles.length; d++) {
+        var originalFile = designFiles[d];
+        var originalName = originalFile.name;
+        
+        var decodedDesignName = File.decode(originalName);
+        var designName = getBaseName(decodedDesignName);
+
+        // Find the upscaled version in the upscaled folder matching this design
+        var upscaledFile = findUpscaledFile(upscaledFolder, designName);
+        if (!upscaledFile) {
+            errorLog.push("Could not find upscaled file for design: " + designName);
+            continue;
+        }
+
+        // Setup the final organized output directories
+        var designOutFolder = new Folder(outputFolder.fsName + "/" + designName);
+        if (!designOutFolder.exists) designOutFolder.create();
+
+        var originalSubFolder = new Folder(designOutFolder.fsName + "/Original_Design");
+        if (!originalSubFolder.exists) originalSubFolder.create();
+
+        var resolutionSubFolder = new Folder(designOutFolder.fsName + "/Resolution_Files");
+        if (!resolutionSubFolder.exists) resolutionSubFolder.create();
+
+        var mockupSubFolder = new Folder(designOutFolder.fsName + "/Mock_Files");
+        if (!mockupSubFolder.exists) mockupSubFolder.create();
+
+        // Copy original unscaled design file into /Original_Design
+        try {
+            originalFile.copy(new File(originalSubFolder.fsName + "/" + File.decode(originalName)));
+        } catch (copyError) {
+            errorLog.push("Failed to copy original design " + designName + ": " + copyError.message);
+        }
+
+        // WebP Auto-Fix for the upscaled file (if upscaled output is WebP)
+        var upscaledOriginalName = upscaledFile.name;
+        var isWebP = false;
+        try {
+            var checkFile = new File(upscaledFile.fsName);
+            checkFile.open("r");
+            checkFile.encoding = "binary";
+            var header = checkFile.read(12);
+            checkFile.close();
+            
+            if (header.indexOf("RIFF") !== -1 && header.indexOf("WEBP") !== -1) {
+                isWebP = true;
+            }
+        } catch (checkError) {}
+
+        var tempWebpName = upscaledOriginalName.replace(/\.[^.]+$/, ".webp");
+        if (isWebP) {
+            try {
+                upscaledFile.rename(tempWebpName);
+            } catch (renameError) {
+                isWebP = false;
+            }
+        }
+
+        // ==========================================
+        // PART A: Generate the 5 Resolution Files
+        // ==========================================
+        for (var r = 0; r < ratioFiles.length; r++) {
+            var ratioFile = ratioFiles[r];
+            var doc = null;
+
+            try {
+                doc = open(ratioFile);
+
+                var canvasW = doc.width.as('px');
+                var canvasH = doc.height.as('px');
+
+                var designDoc = open(upscaledFile);
+                app.activeDocument = designDoc;
+                designDoc.flatten();
+
+                var dW = designDoc.width.as('px');
+                var dH = designDoc.height.as('px');
+
+                designDoc.selection.selectAll();
+                designDoc.selection.copy();
+                designDoc.close(SaveOptions.DONOTSAVECHANGES);
+
+                app.activeDocument = doc;
+                var designLayer = doc.paste();
+
+                if (useStretch) {
+                    var sX = (canvasW / dW) * 100;
+                    var sY = (canvasH / dH) * 100;
+                    designLayer.resize(sX, sY, AnchorPosition.MIDDLECENTER);
+                } else {
+                    var sX = canvasW / dW;
+                    var sY = canvasH / dH;
+                    var scale = Math.max(sX, sY) * 100;
+                    designLayer.resize(scale, scale, AnchorPosition.MIDDLECENTER);
+                }
+
+                var nb = designLayer.bounds;
+                var cx = (nb[0].as('px') + nb[2].as('px')) / 2;
+                var cy = (nb[1].as('px') + nb[3].as('px')) / 2;
+                designLayer.translate((canvasW / 2) - cx, (canvasH / 2) - cy);
+
+                // Save JPG (20MB Quality Safeguard)
+                var outFileName = getBaseName(File.decode(ratioFile.name)) + ".jpg";
+                var outFile = new File(resolutionSubFolder.fsName + "/" + outFileName);
+                saveAsJPEG(doc, outFile);
+
+                successCount++;
+
+            } catch (e) {
+                errorLog.push("FAILED (Ratio): " + designName + " + " + File.decode(ratioFile.name) + "\n  Error: " + e.message);
+            }
+
+            if (doc !== null) {
+                try { doc.close(SaveOptions.DONOTSAVECHANGES); } catch (e2) {}
+                doc = null;
+            }
+        }
+
+        // ==========================================
+        // PART B: Generate all Mockup Files
+        // ==========================================
+        for (var m = 0; m < mockupFiles.length; m++) {
+            var mockupFile = mockupFiles[m];
+            var doc = null;
+
+            try {
+                doc = open(mockupFile);
+
+                var targetNames = ["Your design here", "Place Your Design Here", "Layer 1", "design"];
+                var smartObjectLayer = findLayerRecursive(doc, targetNames);
+
+                if (smartObjectLayer) {
+                    doc.activeLayer = smartObjectLayer;
+
+                    // Open Smart Object PSB
+                    var idplacedLayerEditContents = stringIDToTypeID("placedLayerEditContents");
+                    executeAction(idplacedLayerEditContents, undefined, DialogModes.NO);
+
+                    var psbDoc = app.activeDocument;
+
+                    // Place design inside Smart Object
+                    var desc = new ActionDescriptor();
+                    desc.putPath(charIDToTypeID("null"), new File(upscaledFile.fsName));
+                    executeAction(charIDToTypeID("Plc "), desc, DialogModes.NO);
+
+                    var placedLayer = psbDoc.activeLayer;
+                    var bounds      = placedLayer.bounds;
+                    var w           = bounds[2].value - bounds[0].value;
+                    var h           = bounds[3].value - bounds[1].value;
+
+                    var canvasW = psbDoc.width.value;
+                    var canvasH = psbDoc.height.value;
+
+                    // Scale
+                    if (useStretch) {
+                        var scaleX = (canvasW / w) * 100;
+                        var scaleY = (canvasH / h) * 100;
+                        placedLayer.resize(scaleX, scaleY, AnchorPosition.MIDDLECENTER);
+                    } else {
+                        var scale = Math.max(canvasW / w, canvasH / h) * 100;
+                        placedLayer.resize(scale, scale, AnchorPosition.MIDDLECENTER);
+                    }
+
+                    // Center
+                    var newBounds = placedLayer.bounds;
+                    var newW      = newBounds[2].value - newBounds[0].value;
+                    var newH      = newBounds[3].value - newBounds[1].value;
+                    var deltaX    = (canvasW / 2) - (newBounds[0].value + newW / 2);
+                    var deltaY    = (canvasH / 2) - (newBounds[1].value + newH / 2);
+                    placedLayer.translate(deltaX, deltaY);
+
+                    // Remove placeholders
+                    var layers = psbDoc.layers;
+                    for (var j = layers.length - 1; j >= 0; j--) {
+                        if (layers[j] !== placedLayer) {
+                            try { layers[j].remove(); } catch (e) {}
+                        }
+                    }
+
+                    // Save and close PSB
+                    psbDoc.close(SaveOptions.SAVECHANGES);
+
+                    // Export mockup JPG
+                    var jpgName = File.decode(mockupFile.name).replace(/\.psd$/i, ".jpg");
+                    var jpgFile = new File(mockupSubFolder.fsName + "/" + jpgName);
+                    
+                    var jpgSaveOptions = new JPEGSaveOptions();
+                    jpgSaveOptions.embedColorProfile = true;
+                    jpgSaveOptions.formatOptions     = FormatOptions.STANDARDBASELINE;
+                    jpgSaveOptions.matte             = MatteType.NONE;
+                    jpgSaveOptions.quality           = 12;
+                    doc.saveAs(jpgFile, jpgSaveOptions, true, Extension.LOWERCASE);
+
+                    successCount++;
+
+                } else {
+                    errorLog.push("Smart Object layer not found in mockup: " + File.decode(mockupFile.name));
+                }
+
+            } catch (e) {
+                errorLog.push("FAILED (Mockup): " + designName + " + " + File.decode(mockupFile.name) + "\n  Error: " + e.message);
+            }
+
+            if (doc !== null) {
+                try { doc.close(SaveOptions.DONOTSAVECHANGES); } catch (e2) {}
+                doc = null;
+            }
+        }
+
+        // Restore extension
+        if (isWebP) {
+            try {
+                upscaledFile.rename(upscaledOriginalName);
+            } catch (restoreError) {}
+        }
+
+        // Purge caches to free RAM
+        try { app.purge(PurgeTarget.ALLCACHES); } catch (e) {}
+    }
+
+    // Restore rulers
+    app.preferences.rulerUnits = originalRulerUnits;
+
+    var totalExpected = (designFiles.length * ratioFiles.length) + (designFiles.length * mockupFiles.length);
+
+    // ---- Step 6: Done ----
+    var doneMsg = "MASTER AUTOMATION COMPLETE!\n\n" +
+        successCount + " of " + totalExpected + " JPGs created successfully.\n\n" +
+        "Output Folder:\n" + outputFolder.fsName;
+    if (errorLog.length > 0) {
+        doneMsg += "\n\n--- WARNINGS / ERRORS ---\n" + errorLog.join("\n");
+    }
+    alert(doneMsg);
+}
+
+function saveAsJPEG(doc, outputFile) {
+    var MAX_BYTES = 20 * 1024 * 1024; // 20 MB
+    var qualities = [12, 11, 10];
+
+    for (var q = 0; q < qualities.length; q++) {
+        var opts               = new JPEGSaveOptions();
+        opts.quality           = qualities[q];
+        opts.formatOptions     = FormatOptions.STANDARDBASELINE;
+        opts.matte             = MatteType.NONE;
+        opts.embedColorProfile = true;
+
+        doc.saveAs(outputFile, opts, true);
+
+        var freshRef = new File(outputFile.absoluteURI);
+        var fileSize = freshRef.length;
+
+        if (fileSize <= MAX_BYTES || q === qualities.length - 1) {
+            break;
+        }
+    }
+}
+
+function getBaseName(filename) {
+    return filename.replace(/\.[^.]+$/, "");
+}
+
+function getImageFiles(folder) {
+    var files = [];
+    var all   = folder.getFiles();
+    for (var i = 0; i < all.length; i++) {
+        if (all[i] instanceof File && all[i].name.match(/\.(jpg|jpeg|png|tif|tiff|bmp)$/i)) {
+            files.push(all[i]);
+        }
+    }
+    files.sort(function(a, b) {
+        return a.name.toLowerCase() > b.name.toLowerCase() ? 1 : -1;
+    });
+    return files;
+}
+
+// Custom function to find upscaled file case-insensitively and handle spaces/encodings
+function findUpscaledFile(upscaledFolder, baseName) {
+    var files = upscaledFolder.getFiles();
+    for (var i = 0; i < files.length; i++) {
+        var file = files[i];
+        if (file instanceof File) {
+            var name = File.decode(file.name).toLowerCase();
+            if (name.indexOf(baseName.toLowerCase()) === 0) {
+                return file;
+            }
+        }
+    }
+    return null;
+}
+
+function getPSDFiles(folder) {
+    var files = [];
+    var all   = folder.getFiles("*.psd");
+    for (var i = 0; i < all.length; i++) {
+        if (all[i] instanceof File) files.push(all[i]);
+    }
+    files.sort(function(a, b) {
+        return a.name.toLowerCase() > b.name.toLowerCase() ? 1 : -1;
+    });
+    return files;
+}
+
+function findLayerRecursive(parent, targetNames) {
+    for (var i = 0; i < parent.layers.length; i++) {
+        var layer = parent.layers[i];
+
+        var isMatch = false;
+        for (var j = 0; j < targetNames.length; j++) {
+            if (layer.name.toLowerCase().indexOf(targetNames[j].toLowerCase()) !== -1) {
+                isMatch = true;
+                break;
+            }
+        }
+
+        if (isMatch && layer.typename === "ArtLayer") {
+            return layer;
+        }
+
+        if (layer.typename === "LayerSet") {
+            var found = findLayerRecursive(layer, targetNames);
+            if (found) return found;
+        }
+    }
+    return null;
+}
