+def get_input_by_label(page, label_name):
+    """
+    Locates the input/select/textarea element associated with a label using:
+    1. Exact label text matching to find the true label and avoid helper-text substrings (like Title).
+    2. The label's 'for' attribute ID.
+    3. Scoped container matches.
+    """
+    try:
+        # Find all labels on the page
+        labels = page.locator("label")
+        label_el = None
+        for i in range(labels.count()):
+            lbl = labels.nth(i)
+            # Get the text content, clean it, and compare the first line
+            text = lbl.inner_text().strip().lower()
+            clean_text = text.replace("*", "").replace("optional", "").strip()
+            first_line = clean_text.split("\n")[0].strip()
+            if first_line == label_name.lower():
+                label_el = lbl
+                break
+
+        if label_el:
+            # Try getting 'for' attribute
+            input_id = label_el.get_attribute("for")
+            if input_id:
+                input_el = page.locator(f"[id='{input_id}']").first
+                if input_el.count():
+                    print(f"  [get_input_by_label] Found input by ID '{input_id}' for label '{label_name}'")
+                    return input_el
+
+            # Try parent container wrapper
+            parent_container = label_el.locator("xpath=..")
+            input_el = parent_container.locator("input, select, textarea").first
+            if input_el.count():
+                print(f"  [get_input_by_label] Found input in parent container of label '{label_name}'")
+                return input_el
+
+        # 2. Scoped class fallback (strictly using wt-pb-xs-6 to avoid large containers)
+        container = page.locator(f"div.wt-pb-xs-6:has(label:has-text('{label_name}'))").first
+        if container.count():
+            input_el = container.locator("input, select, textarea").first
+            if input_el.count():
+                print(f"  [get_input_by_label] Found input in scoped div container for label '{label_name}'")
+                return input_el
+
+    except Exception as e:
+        print(f"Error finding input for label {label_name}: {e}")
+    return None
+
+def select_dropdown_attribute(page, label_name, option_name):
+    print(f"Selecting dropdown attribute: {label_name} -> {option_name}...")
+    try:
+        select_el = get_input_by_label(page, label_name)
+        if select_el and select_el.count():
+            # Scroll to center of viewport
+            select_el.evaluate("el => el.scrollIntoView({block: 'center', inline: 'center'})")
+            time.sleep(0.5)
+            select_el.select_option(option_name)
+            print(f"  -> Successfully selected: {option_name}")
+            return True
+    except Exception as e:
+        print(f"  -> Warning: Could not select dropdown {label_name} -> {option_name}: {e}")
+    return False
+
+def select_typeahead_attribute(page, label_name, option_name):
+    print(f"Selecting attribute: {label_name} -> {option_name}...")
+    try:
+        input_field = get_input_by_label(page, label_name)
+        if input_field and input_field.count():
+            # Scroll to center of viewport
+            input_field.evaluate("el => el.scrollIntoView({block: 'center', inline: 'center'})")
+            time.sleep(0.5)
+            
+            # Click using native JS click to trigger dropdown safely
+            input_field.evaluate("el => el.click()")
+            time.sleep(1.5)
+            
+            # Fill the option name to filter suggestions
+            input_field.fill(option_name)
+            time.sleep(2)
+            
+            # Find options strictly inside the ancestor typeahead/field container first to prevent leakage to materials
+            typeahead_container = input_field.locator("xpath=ancestor::div[contains(@class, 'wt-typeahead') or contains(@class, 'wt-pb-xs-6') or contains(@class, 'wt-validation-block')]").first
+            if typeahead_container.count():
+                options = typeahead_container.locator(".wt-options__item")
+            else:
+                options = page.locator(".wt-options__item")
+                
+            if not options.count():
+                options = page.locator(".wt-options__item")
+                
+            # Match exact string first (to avoid matching 'Dried flowers' for 'Flowers')
+            option_btn = None
+            for i in range(options.count()):
+                opt = options.nth(i)
+                opt_text = opt.inner_text().strip()
+                if opt_text.lower() == option_name.lower():
+                    option_btn = opt
+                    break
+                    
+            if not option_btn:
+                # Substring fallback
+                option_btn = options.filter(has_text=option_name).first
+                
+            if option_btn and option_btn.count():
+                option_btn.evaluate("el => el.click()")
+                print(f"  -> Successfully selected: {option_name}")
+                time.sleep(1)
+                return True
+            else:
+                print(f"  -> Warning: Option '{option_name}' not found in suggestion list.")
+    except Exception as e:
+        print(f"  -> Warning: Could not select {label_name} -> {option_name}: {e}")
+    return False
