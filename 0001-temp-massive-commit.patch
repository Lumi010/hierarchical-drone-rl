@@ -0,0 +1,116 @@
+// Photoshop Script (JSX) to automate TV and Frame mockup creation.
+// Swaps the Smart Object layer (e.g., "Place Your Design Here", "Layer 1") with your new design JPG.
+// Custom behavior:
+// - Files containing "3840" or "2160" in the filename (4K resolution files) are saved as a copy JPG with max quality (12).
+// - All other files (normal mockups) are exported using Photoshop's "Export As / Save for Web" option as a JPG with "Great" quality (80%).
+
+var designFile = File.openDialog("Select your new design JPG:");
+if (designFile) {
+    var mockupFolder = Folder.selectDialog("Select the folder containing your PSD mockups:");
+    if (mockupFolder) {
+        var files = mockupFolder.getFiles("*.psd");
+        
+        if (files.length === 0) {
+            alert("No PSD files found in the selected folder.");
+        } else {
+            // Helper function to recursively find a layer by name
+            var findLayerRecursive = function(parent, name) {
+                for (var i = 0; i < parent.artLayers.length; i++) {
+                    if (parent.artLayers[i].name.toLowerCase() === name.toLowerCase()) {
+                        return parent.artLayers[i];
+                    }
+                }
+                for (var i = 0; i < parent.layerSets.length; i++) {
+                    var found = findLayerRecursive(parent.layerSets[i], name);
+                    if (found) return found;
+                }
+                return null;
+            };
+
+            // Helper function to recursively find the first Smart Object layer as a fallback
+            var findFirstSmartObject = function(parent) {
+                for (var i = 0; i < parent.artLayers.length; i++) {
+                    if (parent.artLayers[i].kind === LayerKind.SMARTOBJECT) {
+                        return parent.artLayers[i];
+                    }
+                }
+                for (var i = 0; i < parent.layerSets.length; i++) {
+                    var found = findFirstSmartObject(parent.layerSets[i]);
+                    if (found) return found;
+                }
+                return null;
+            };
+
+            // Loop through each PSD mockup file
+            for (var i = 0; i < files.length; i++) {
+                var doc = open(files[i]);
+                var filename = doc.name.toLowerCase();
+                
+                // Determine if this is the 4K resolution file
+                var is4K = (filename.indexOf("3840") !== -1 || filename.indexOf("2160") !== -1);
+                
+                try {
+                    var smartObjectLayer = null;
+                    
+                    // Priority list of names to search for
+                    var targetNames = is4K 
+                        ? ["Layer 1", "Place Your Design Here", "design"]
+                        : ["Place Your Design Here", "Layer 1", "design"];
+                    
+                    // Search for the layer
+                    for (var j = 0; j < targetNames.length; j++) {
+                        smartObjectLayer = findLayerRecursive(doc, targetNames[j]);
+                        if (smartObjectLayer) break;
+                    }
+                    
+                    // Fallback to first smart object if name matches fail
+                    if (!smartObjectLayer) {
+                        smartObjectLayer = findFirstSmartObject(doc);
+                    }
+                    
+                    if (!smartObjectLayer) {
+                        throw new Error("Could not find any Smart Object layer in this PSD.");
+                    }
+                    
+                    doc.activeLayer = smartObjectLayer;
+                    
+                    // Replace the smart object content directly using Action Manager
+                    var idplacedLayerReplaceContents = stringIDToTypeID("placedLayerReplaceContents");
+                    var desc = new ActionDescriptor();
+                    desc.putPath(charIDToTypeID("null"), new File(designFile));
+                    executeAction(idplacedLayerReplaceContents, desc, DialogModes.NO);
+                    
+                    var jpgFile = new File(doc.path + "/" + doc.name.replace(".psd", ".jpg"));
+
+                    if (is4K) {
+                        // Max quality (12) save as copy for 4K resolution file
+                        var jpgSaveOptions = new JPEGSaveOptions();
+                        jpgSaveOptions.embedColorProfile = true;
+                        jpgSaveOptions.formatOptions = FormatOptions.STANDARDBASELINE;
+                        jpgSaveOptions.matte = MatteType.NONE;
+                        jpgSaveOptions.quality = 12;
+                        
+                        doc.saveAs(jpgFile, jpgSaveOptions, true, Extension.LOWERCASE);
+                    } else {
+                        // Export As JPG with "Great" Quality (80%) for normal mockups
+                        var exportOptions = new ExportOptionsSaveForWeb();
+                        exportOptions.format = SaveDocumentType.JPEG;
+                        exportOptions.quality = 80; // 80% is the "Great" quality preset in Photoshop Export As
+                        exportOptions.optimized = true;
+                        exportOptions.includeProfile = true; // Preserve color profile so colors stay accurate
+                        
+                        doc.exportDocument(jpgFile, ExportType.SAVEFORWEB, exportOptions);
+                    }
+                    
+                } catch (e) {
+                    alert("Error processing file: " + doc.name + "\nDetails: " + e.message);
+                }
+                
+                // Close the PSD without saving changes so the original template remains clean
+                doc.close(SaveOptions.DONOTSAVECHANGES);
+            }
+            
+            alert("Automation complete! All JPG mockups exported.");
+        }
+    }
+}
