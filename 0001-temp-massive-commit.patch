utton" data-attributes-toggle="true" data-clg-id="WtButton" class="wt-btn wt-btn--tertiary wt-width-full">Show less</button></div></div></div></div><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" id="pricing-logistics" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><div><h2 class="wt-text-title-large">Price and inventory</h2><p class="wt-text-caption wt-sem-text-secondary">Set your item price, and how many are available for sale.</p></div><div role="none"></div><div id="field-variations-configuration.price" class="wt-mt-md-6 wt-mt-xs-4"><label for="listing-price-input" class="wt-label">Price <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></label><div class="wt-display-flex-xs wt-justify-content-flex-start wt-flex-grid-gap-xs-0 wt-flex-direction-column-xs wt-flex-direction-row-lg"><div class="wt-mt-xs-2 wt-mt-tv-0 wt-mr-xs-2 wt-mr-lg-0 wt-pr-lg-2 wt-align-self-flex-end"><div class="wt-input__prepend-wrapper"><span id="addon-8a3747f4-866f-4166-9ea1-8e1d3f3c315b" class="wt-input__prepend">USD </span><input data-clg-id="WtInput" type="text" aria-describedby="" data-testid="price-input" name="variations.configuration.price" id="listing-price-input" aria-invalid="false" inputmode="decimal" aria-required="true" class="wt-input wt-pl-xs-8"></div></div><div class="wt-mt-xs-2 wt-mt-tv-0 wt-align-self-flex-end wt-ml-xs-0 wt-ml-lg-2 wt-mt-xs-2 wt-mt-lg-0 wt-align-self-flex-end"><button type="button" data-testid="domestic-price-trigger-button" data-clg-id="WtButton" class="wt-btn wt-btn--secondary wt-display-flex-xs wt-align-items-center wt-no-wrap"><span class="wt-mr-xs-1 wt-align-content-center etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.696 2.5A1 1 0 0 1 13.694 3.553L13.32 10.68 20.447 10.306A1 1 0 0 1 21.5 11.304V12.696A1 1 0 0 1 20.447 13.694L13.32 13.32 13.694 20.447A1 1 0 0 1 12.696 21.5H11.304A1 1 0 0 1 10.306 20.447L10.68 13.32 3.553 13.694A1 1 0 0 1 2.5 12.696V11.304A1 1 0 0 1 3.553 10.306L10.68 10.68 10.306 3.553A1 1 0 0 1 11.304 2.5z"></path></svg></span>Add global prices</button></div></div></div><div role="none"></div><div class="wt-display-flex-xs wt-pal-grid-mt-xs-400 wt-flex-direction-column-xs wt-flex-direction-row-md wt-pal-grid-mb-xs-400"><div class="wt-display-flex-xs wt-flex-direction-column-xs wt-pal-grid-mr-xs-300 wt-align-self-center"><span class="wt-sem-text-primary wt-text-title wt-display-flex-xs wt-mb-xs-1">Estimate US tariff costs<clg-signal class="wt-pal-grid-ml-xs-100" size="base" variant="strong" color="highlight">New</clg-signal></span><span class="wt-text-body-small--tight">You can use this estimate to build tariff costs into your US prices.<a href="https://help.etsy.com/hc/articles/40309848355735-How-to-Use-Etsy-s-US-Estimated-Tariffs-Calculator" target="_blank" class="wt-ml-xs-1">Learn more.</a></span></div><div class="wt-mt-xs-2 wt-mt-md-0"><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--tertiary">Get started</button></div></div><div data-clg-id="WtAccordion" class="wt-mt-xs-1 wt-mt-sm-2 le-earnings-calculator wt-animated wt-animated--appear-01 wt-animated--appear-from-top"><button type="button" aria-controls="field-productionCost" aria-expanded="false" data-clg-id="WtButton" class="wt-btn wt-btn--transparent wt-content-toggle--btn wt-content-toggle--with-icon le-content-toggle wt-btn--transparent-flush-left"><span class="wt-flex-xs-auto wt-width-full"><div><span class="wt-icon--smaller-xs wt-fill-denim-light wt-p-2-xs wt-mr-xs-1 wt-nudge-b-2 etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.962 20C15.306 20 15.547 20.34 15.392 20.648 14.687 22.06 13.432 23 12 23S9.315 22.06 8.608 20.648C8.454 20.34 8.695 20 9.04 20z"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M12 1A8.5 8.5 0 0 1 16.486 16.719 1 1 0 0 0 16 17.562C16 18.08 15.58 18.5 15.063 18.5H8.936A.94.94 0 0 1 8 17.563C8 17.217 7.807 16.902 7.514 16.719A8.5 8.5 0 0 1 12 1M11.5 11A.5.5 0 0 0 11 11.5V16A.5.5 0 0 0 11.5 16.5H12.5A.5.5 0 0 0 13 16V11.5A.5.5 0 0 0 12.5 11z"></path></svg></span>Estimated earnings: USD 2.46</div></span><span aria-hidden="true" class="wt-content-toggle--btn__icon"></span></button><div id="field-productionCost" aria-hidden="true" class="wt-content-toggle__body" style="max-height: 0px;" tabindex="-1"><div data-clg-id="WtPanel" class="wt-panel wt-mt-xs-1 wt-text-body wt-display-inline-block wt-grid wt-grid__item-xs-12 wt-grid__item-sm-8 wt-grid__item-tv-7 wt-display-flex-xs wt-flex-direction-column-xs"><div class="le-earnings-calculator__breakdown-row wt-display-flex-xs wt-flex-xs-auto wt-flex-direction-row-xs"><div class="wt-flex-xs-1 wt-align-self-center">Item price</div><div id="le-formatted-price" class="wt-flex-xs-1 wt-text-right-xs wt-align-self-center">USD 3.40</div></div><div class="wt-display-flex-xs wt-flex-xs-auto wt-flex-direction-row-xs"><div class="wt-flex-xs-1 wt-align-self-center"><div data-clg-id="WtPopoverControlled" class="wt-popover"><button type="button" aria-describedby="popover-content-4ff0cc5b-ef26-4f12-8e2e-c60e8673dcdf" class="wt-popover__trigger wt-text-body wt-popover__trigger--underline">Your costs</button><div role="tooltip" id="popover-content-4ff0cc5b-ef26-4f12-8e2e-c60e8673dcdf"><p class="wt-mb-xs-2 wt-text-title-small">Include any costs involved in making and selling your item</p><p class="wt-mb-xs-2 wt-text-body-small">Consider things like materials, labour, packaging, marketing, and postage not covered by the buyer. And make sure to include the cost of your time, even if it's just an estimate!</p><span class="wt-popover__arrow"></span></div></div></div><div class="wt-display-flex wt-flex-wrap wt-align-content-flex-start wt-align-items-center" style="height: 56px;"><span>-</span><span> </span><div class="wt-display-inline-block wt-text-right-xs wt-flex-xs-1 wt-input__prepend-wrapper"><span id="addon-3afe89cc-cf0c-467b-b4ad-fe0d1aff6afb" class="wt-input__prepend">USD </span><input data-clg-id="WtInput" type="text" aria-describedby="" data-testid="price-input" name="productionCost" id="production-cost-input" aria-invalid="false" inputmode="decimal" aria-required="true" class="wt-input wt-pl-xs-8"></div></div></div><div class="le-earnings-calculator__breakdown-row wt-display-flex-xs wt-flex-xs-auto wt-flex-direction-row-xs"><div class="wt-flex-xs-1 wt-align-self-center"><div data-clg-id="WtPopoverControlled" class="wt-popover"><button type="button" aria-describedby="popover-content-bc51fe28-bf72-499a-8d3d-24f8751fb7d9" class="wt-popover__trigger wt-text-body wt-popover__trigger--underline">Estimated fees</button><div role="tooltip" id="popover-content-bc51fe28-bf72-499a-8d3d-24f8751fb7d9"><p class="wt-mb-xs-2 wt-text-title-small">We included the listing, transaction, and payment processing fees here</p><p class="wt-mb-xs-2 wt-text-body-small">It’s just an estimate&nbsp;– this number could be lower if a sale comes from your Etsy Share &amp; Save link, or higher if a sale comes from an offsite ad, for example.</p><span class="wt-popover__arrow"></span></div></div></div><div id="le-estimated-fees" class="wt-flex-xs-1 wt-text-right-xs wt-align-self-center">-USD 0.94</div></div><div class="wt-display-flex-xs wt-flex-xs-auto wt-flex-direction-row-xs wt-bt-xs wt-text-title wt-pt-xs-1"><div class="wt-flex-xs-1 wt-align-self-center">Estimated earnings</div><div id="le-estimated-profit" class="wt-flex-xs-1 wt-text-right-xs wt-align-self-center">USD 2.46</div></div><div data-clg-id="WtBanner" data-test-id="pricing-tips-banner" id="wt-banner-6281c190-11fa-4840-87b2-9ab42ae665e1" class="wt-banner wt-banner--informational-01 wt-mt-xs-2 wt-animated wt-animated--disappear-02 wt-animated--disappear-to-top"><div data-clg-id="WtBannerLayout" class="wt-banner__layout"><div class="wt-display-flex-xs wt-align-items-center"><div><div data-clg-id="WtBannerText"><p class="wt-banner__title wt-mb-xs-1">Get tips for pricing your listings</p><p class="wt-banner__body-text">If your estimated earnings are a negative number it might mean you’ve priced your item too low, or that your production costs deserve a second look. Check out our Ultimate Guide to Pricing for tips on where to start.</p></div></div></div><a data-clg-id="WtTextLink" target="_blank" href="https://www.etsy.com/seller-handbook/article/745293633907" class="wt-text-caption wt-arrow-link wt-arrow-link--forward" tabindex="-1">Get tips<span class="wt-screen-reader-only">Opens a new tab</span></a></div></div><div class="wt-mt-xs-3 wt-text-body-small wt-sem-text-secondary">This optional tool is for sellers who want pricing guidance&nbsp;– it won’t impact your listing in any way. For a more detailed version, try this <a data-clg-id="WtTextLink" target="_blank" href="https://docs.google.com/spreadsheets/d/16j_fqx8doCKfzEwk5sG9ebP381c7N1ZHCAcVqR2f1yQ" class="wt-text-link">pricing worksheet<span class="wt-screen-reader-only">Opens a new tab</span></a>.</div></div></div></div><div id="field-quantity" class="wt-mt-md-6 wt-mt-xs-4"><label for="listing-quantity-input" class="wt-label">Quantity <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></label><div data-clg-id="WtGrid" class="wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-6 wt-grid__item-sm-6 wt-grid__item-md-6 wt-grid__item-lg-6 wt-grid__item-xl-6 wt-grid__item-tv-3"><input data-clg-id="WtInput" type="text" aria-describedby="" name="quantity" inputmode="decimal" id="listing-quantity-input" aria-invalid="false" aria-required="true" class="wt-input"></div></div></div><div id="field-sku" class="wt-mt-md-6 wt-mt-xs-4"><div class="listing-editor-sku-input__container"><label for="listing-sku-input" class="wt-label">SKU</label><div data-clg-id="WtGrid" class="wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-6 wt-grid__item-sm-6 wt-grid__item-md-6 wt-grid__item-lg-6 wt-grid__item-xl-6 wt-grid__item-tv-3"><input id="listing-sku-input" name="sku" aria-invalid="false" aria-describedby="" aria-hidden="false" class="wt-input"><div class="wt-display-inline-block-xs"><div class="wt-display-flex-xs wt-justify-content-space-between"><span id="sku-character-count" data-testid="sku-character-count" class="le-text-caption wt-text-gray wt-mt-xs-1 wt-ml-xs-1">0/32</span></div></div></div></div></div></div></div></div></div><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><div><h2 class="wt-text-title-large">Delivery, processing, and returns</h2><p class="wt-text-caption wt-sem-text-secondary">Give clear expectations about delivery time and cost by making sure your delivery info is accurate&nbsp;- including the delivery profile and your order processing schedule. You can make updates any time in <a href="/your/shops/me/tools/shipping-profiles?formRef=listing_editor" target="_blank" rel="noopener noreferrer" class="wt-text-link">Delivery settings</a>.</p></div><div class="wt-mt-md-6 wt-mt-xs-4"><div id="field-readinessStateId" class="wt-mb-xs-6"><p class="wt-label le-margin-right-auto">Processing profile  <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></p><div data-clg-id="WtPanel" class="wt-panel"><div class="wt-display-flex-xs wt-flex-direction-column-xs wt-flex-direction-row-md wt-justify-content-space-between wt-align-items-center"><div class="le-margin-right-auto wt-mb-xs-3 wt-mb-md-0"><p class="wt-label">Ready to dispatch</p><p>1-2 days</p></div><div class="wt-display-flex-xs wt-flex-direction-column-xs wt-flex-direction-row-md wt-width-full-xs wt-width-auto-md"><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--tertiary">Change profile</button></div></div></div></div><div data-clg-id="WtPanel" class="wt-panel"><div id="field-sourceShippingProfileId" data-testid="empty-profile" class="wt-display-flex-xs wt-flex-direction-column-xs wt-flex-direction-row-md wt-justify-content-space-between wt-align-items-center"><p class="wt-label le-margin-right-auto">Delivery option  <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></p><div class="wt-display-flex-xs wt-flex-direction-column-xs wt-flex-direction-row-md wt-width-full-xs wt-width-auto-md"><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--transparent wt-display-flex-xs wt-align-items-center wt-mr-xs-0 wt-mr-md-2 wt-mb-xs-2 wt-mb-md-0 wt-mt-xs-2 wt-mt-md-0"><span class="etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.696 2.5A1 1 0 0 1 13.694 3.553L13.32 10.68 20.447 10.306A1 1 0 0 1 21.5 11.304V12.696A1 1 0 0 1 20.447 13.694L13.32 13.32 13.694 20.447A1 1 0 0 1 12.696 21.5H11.304A1 1 0 0 1 10.306 20.447L10.68 13.32 3.553 13.694A1 1 0 0 1 2.5 12.696V11.304A1 1 0 0 1 3.553 10.306L10.68 10.68 10.306 3.553A1 1 0 0 1 11.304 2.5z"></path></svg></span> Create option</button><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--secondary">Select profile</button></div></div></div><div data-clg-id="WtAccordion" class="wt-mt-xs-6"><button type="button" aria-controls="shipping-cost-preview-accordion" aria-expanded="false" data-clg-id="WtButton" class="wt-btn wt-btn--transparent wt-content-toggle--btn wt-content-toggle--with-icon wt-btn--transparent-flush-left"><span class="wt-flex-xs-auto wt-width-full"><div><span class="wt-icon--smaller-xs wt-fill-denim-light wt-p-2-xs wt-mr-xs-1 wt-nudge-b-2 etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.962 20C15.306 20 15.547 20.34 15.392 20.648 14.687 22.06 13.432 23 12 23S9.315 22.06 8.608 20.648C8.454 20.34 8.695 20 9.04 20z"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M12 1A8.5 8.5 0 0 1 16.486 16.719 1 1 0 0 0 16 17.562C16 18.08 15.58 18.5 15.063 18.5H8.936A.94.94 0 0 1 8 17.563C8 17.217 7.807 16.902 7.514 16.719A8.5 8.5 0 0 1 12 1M11.5 11A.5.5 0 0 0 11 11.5V16A.5.5 0 0 0 11.5 16.5H12.5A.5.5 0 0 0 13 16V11.5A.5.5 0 0 0 12.5 11z"></path></svg></span>Preview postage cost</div></span><span aria-hidden="true" class="wt-content-toggle--btn__icon"></span></button><div id="shipping-cost-preview-accordion" aria-hidden="true" class="wt-content-toggle__body" style="max-height: 0px;" tabindex="-1"><div data-clg-id="WtPanel" class="wt-panel wt-mt-xs-2 wt-max-width-sm wt-ml-xs-0"></div></div></div></div><div id="field-returnPolicyId" class="wt-mt-md-6 wt-mt-xs-4"><label for="policies-section-select" class="wt-label">Returns and exchanges <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></label><div data-clg-id="WtBanner" id="wt-banner-55311937-0cac-4e08-8ffe-945740bc6a7f" class="wt-banner wt-banner--informational-01 settings-banner-wrapper wt-mb-xs-2"><div data-clg-id="WtBannerLayout" class="wt-banner__layout"><div class="wt-display-flex-xs wt-align-items-flex-start"><div class="wt-banner__icon-frame wt-show-xs"><span class="etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.962 20C15.306 20 15.547 20.34 15.392 20.648 14.687 22.06 13.432 23 12 23S9.315 22.06 8.608 20.648C8.454 20.34 8.695 20 9.04 20z"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M12 1A8.5 8.5 0 0 1 16.486 16.719 1 1 0 0 0 16 17.562C16 18.08 15.58 18.5 15.063 18.5H8.936A.94.94 0 0 1 8 17.563C8 17.217 7.807 16.902 7.514 16.719A8.5 8.5 0 0 1 12 1M11.5 11A.5.5 0 0 0 11 11.5V16A.5.5 0 0 0 11.5 16.5H12.5A.5.5 0 0 0 13 16V11.5A.5.5 0 0 0 12.5 11z"></path></svg></span></div><div><div data-clg-id="WtBannerText"><p class="wt-banner__title wt-mb-xs-1">Let buyers know how you'll handle returns for this listing</p><p class="wt-banner__body-text">Get started with a 30-day return and exchange policy or <button type="button" class="wt-text-link">create a different policy</button> that fits this listing best. <a data-clg-id="WtTextLink" target="_blank" href="https://help.etsy.com/hc/en-us/articles/7869401615255" class="wt-sem-text-primary wt-text-link">Learn about return policies<span class="wt-screen-reader-only">Opens a new tab</span></a></p></div></div></div></div></div><div data-test-id="0_card" data-tour-anchor="return-policy-summary" class="wt-panel wt-mb-xs-1 wt-p-xs-3 wt-p-md-4 wt-b-xs"><div data-test-id="policy-desktop-card" class="wt-hide-xs wt-show-sm"><div class="wt-display-flex-xs wt-justify-content-space-between wt-align-items-center"><div><div class="wt-hide-sm wt-hide-md wt-show-lg"><div class="wt-display-flex-xs wt-align-item-center"><p class="wt-text-title-01 wt-mr-xs-1">Simple policy</p><div class="wt-display-flex-xs wt-align-item-center"><span class="wt-mr-xs-1 wt-icon--smaller-xs etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.5 3A.5.5 0 0 1 9 3.5V4H15V3.5A.5.5 0 0 1 15.5 3H16.5A.5.5 0 0 1 17 3.5V4H21.5A.5.5 0 0 1 22 4.5V20.5A.5.5 0 0 1 21.5 21H2.5A.5.5 0 0 1 2 20.5V4.5A.5.5 0 0 1 2.5 4H7V3.5A.5.5 0 0 1 7.5 3zM16.5 14.5A.5.5 0 0 0 16 15V17A.5.5 0 0 0 16.5 17.5H18.5A.5.5 0 0 0 19 17V15A.5.5 0 0 0 18.5 14.5zM4 9H20V6H17V6.5A.5.5 0 0 1 16.5 7H15.5A.5.5 0 0 1 15 6.5V6H9V6.5A.5.5 0 0 1 8.5 7H7.5A.5.5 0 0 1 7 6.5V6H4z"></path></svg></span><p class="wt-text-title-01 wt-mr-xs-2">30 days</p></div></div></div><div class="wt-show-sm wt-show-md wt-hide-lg"><p class="wt-text-title-01 wt-mb-xs-1">Simple policy</p><div class="wt-display-flex-xs wt-align-item-center"><div class="wt-display-flex-xs wt-align-item-center"><span class="wt-mr-xs-1 wt-icon--smaller-xs etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.5 3A.5.5 0 0 1 9 3.5V4H15V3.5A.5.5 0 0 1 15.5 3H16.5A.5.5 0 0 1 17 3.5V4H21.5A.5.5 0 0 1 22 4.5V20.5A.5.5 0 0 1 21.5 21H2.5A.5.5 0 0 1 2 20.5V4.5A.5.5 0 0 1 2.5 4H7V3.5A.5.5 0 0 1 7.5 3zM16.5 14.5A.5.5 0 0 0 16 15V17A.5.5 0 0 0 16.5 17.5H18.5A.5.5 0 0 0 19 17V15A.5.5 0 0 0 18.5 14.5zM4 9H20V6H17V6.5A.5.5 0 0 1 16.5 7H15.5A.5.5 0 0 1 15 6.5V6H9V6.5A.5.5 0 0 1 8.5 7H7.5A.5.5 0 0 1 7 6.5V6H4z"></path></svg></span><p class="wt-text-title-01 wt-mr-xs-2">30 days</p></div></div></div><div class="wt-mb-xs-1"><p class="wt-text-body-01 wt-line-height-tight">Buyer is responsible for return postage costs and any loss in value if an item isn't returned in original condition.</p></div></div><div class="wt-no-wrap wt-pl-xs-2 wt-display-inline-flex-xs"><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--tertiary">Apply this policy</button></div></div></div><div data-test-id="policy-mobile-card" class="wt-show-xs wt-hide-sm"><p class="wt-text-title-01 wt-mb-xs-1">Simple policy<span class="wt-ml-xs-1"><span class="wt-mr-xs-1 wt-icon--smaller-xs etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.5 3A.5.5 0 0 1 9 3.5V4H15V3.5A.5.5 0 0 1 15.5 3H16.5A.5.5 0 0 1 17 3.5V4H21.5A.5.5 0 0 1 22 4.5V20.5A.5.5 0 0 1 21.5 21H2.5A.5.5 0 0 1 2 20.5V4.5A.5.5 0 0 1 2.5 4H7V3.5A.5.5 0 0 1 7.5 3zM16.5 14.5A.5.5 0 0 0 16 15V17A.5.5 0 0 0 16.5 17.5H18.5A.5.5 0 0 0 19 17V15A.5.5 0 0 0 18.5 14.5zM4 9H20V6H17V6.5A.5.5 0 0 1 16.5 7H15.5A.5.5 0 0 1 15 6.5V6H9V6.5A.5.5 0 0 1 8.5 7H7.5A.5.5 0 0 1 7 6.5V6H4z"></path></svg></span>30 days</span></p><div class="wt-display-flex-xs wt-justify-content-space-around wt-flex-direction-column-xs"><div class="wt-justify-content-center wt-display-inline-flex-xs"><p class="wt-text-caption">Buyer is responsible for return postage costs and any loss in value if an item isn't returned in original condition.</p></div></div><div class="wt-mt-xs-2"><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--tertiary">Apply this policy</button></div></div></div><div data-clg-id="WtFormFieldError" class="wt-validation wt-display-flex-xs wt-align-items-top"><div class="wt-validation__icon__frame"><span class="wt-validation__icon etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M11 6V14H13V6zM12 15.25A1.25 1.25 0 1 0 12 17.75 1.25 1.25 0 0 0 12 15.25"></path></svg></span></div><ul id="returnPolicyId-no_return_policy_error" class="wt-list-unstyled"><li class="wt-validation__message">Please apply a return policy</li></ul></div></div></div></div></div><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><fieldset id="gpsr=compliance"><div class="wt-display-flex-xs wt-align-items-center wt-flex-wrap wt-justify-content-space-between"><div class="wt-flex-md-1 wt-pr-md-3"><p class="wt-text-title">GPSR manufacturer and safety information</p>If you’re a <a data-clg-id="WtTextLink" target="_blank" href="https://www.etsy.com/seller-handbook/article/1364599291081#TRDR" class="wt-text-link">“trader”<span class="wt-screen-reader-only">Opens a new tab</span></a> selling to <a data-clg-id="WtTextLink" target="_blank" href="https://www.etsy.com/seller-handbook/article/1093438529659#GPSR" class="wt-text-link">EEA states<span class="wt-screen-reader-only">Opens a new tab</span></a> or Northern Ireland (NI), you may need to include manufacturer and safety info (for listings added after 13 December 2024) to comply with the <a data-clg-id="WtTextLink" target="_blank" href="https://www.etsy.com/seller-handbook/article/1093438529659" class="wt-text-link">General Product Safety Regulation<span class="wt-screen-reader-only">Opens a new tab</span></a> (GPSR).<br><br>You can also choose to stop selling to these states in <a data-clg-id="WtTextLink" target="_blank" href="/your/shops/me/options?ref=seller-platform-mcnav#gpsr-policy-setting-heading" class="wt-text-link">GPSR settings<span class="wt-screen-reader-only">Opens a new tab</span></a>.</div><button type="button" aria-expanded="false" data-clg-id="WtButton" class="wt-btn wt-btn--secondary wt-flex-basis-xs-auto wt-mt-xs-2 wt-mt-md-0 wt-display-flex-xs wt-align-items-center"><span class="wt-mr-xs-1 etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.696 2.5A1 1 0 0 1 13.694 3.553L13.32 10.68 20.447 10.306A1 1 0 0 1 21.5 11.304V12.696A1 1 0 0 1 20.447 13.694L13.32 13.32 13.694 20.447A1 1 0 0 1 12.696 21.5H11.304A1 1 0 0 1 10.306 20.447L10.68 13.32 3.553 13.694A1 1 0 0 1 2.5 12.696V11.304A1 1 0 0 1 3.553 10.306L10.68 10.68 10.306 3.553A1 1 0 0 1 11.304 2.5z"></path></svg></span> Add info</button></div></fieldset><div id="compliance-form" class="wt-display-none"><div id="field-gpsrManufacturerContact" class="wt-mt-md-6 wt-mt-xs-4"><label for="gspr-manufacturer-info-textarea" class="wt-label wt-mb-xs-0">Manufacturers<div data-clg-id="WtPopoverControlled" class="wt-popover"><button type="button" aria-describedby="popover-content-f91fe3da-4526-4bf2-a045-adf8c4700668" aria-label="Help" class="wt-popover__trigger wt-text-body-01"><span class="wt-mr-xs-1 wt-nudge-b-1 wt-icon--base-xs etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.059 17H10.677V14.744H13.059zM12.195 7C14.034 7 15.398 8.045 15.398 9.744 15.398 10.747 14.828 11.568 14.173 12.056L13.602 12.5C13.058 12.919 12.878 13.254 12.878 13.951H10.858C10.858 12.626 11.178 12.013 12.056 11.358L12.585 10.983C13.058 10.635 13.268 10.26 13.268 9.827 13.268 9.16 12.822 8.755 12.14 8.755 11.276 8.755 10.774 9.285 10.774 10.356H8.602C8.602 8.31 9.995 7 12.195 7"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C17.523 2 22 6.477 22 12S17.523 22 12 22 2 17.523 2 12 6.477 2 12 2M12 4.5A7.5 7.5 0 1 0 12 19.5 7.5 7.5 0 0 0 12 4.5"></path></svg></span></button><div role="tooltip" id="popover-content-f91fe3da-4526-4bf2-a045-adf8c4700668"><p class="wt-mb-xs-2 wt-text-caption">The GPSR considers a “manufacturer” to be anyone who designs or makes a product and sells it under their name or brand.</p><p class="wt-mt-xs-2 wt-text-caption"> Selling items you designed, made, or modified? You’re probably the manufacturer.</p><p class="wt-mt-xs-2 wt-text-caption"> Selling second-hand items in their original condition? The manufacturer is likely someone else. </p><span class="wt-popover__arrow"></span></div></div></label><p id="gspr-manufacturer-info-helper-text" class="wt-text-caption wt-display-block wt-mb-xs-1">You’ll need to include a name, email, and mailing address for each manufacturer. If you’re a non-EU resident and make the item yourself, or you work with a non-EU manufacturer, you’ll need to provide the name and email of the designated EU <a data-clg-id="WtTextLink" target="_blank" href="https://www.etsy.com/seller-handbook/article/1364599291081#RES" class="wt-text-link">“responsible person”<span class="wt-screen-reader-only">Opens a new tab</span></a>.</p><textarea name="gpsrManufacturerContact" id="gspr-manufacturer-info-textarea" aria-invalid="false" aria-required="false" aria-describedby="gspr-manufacturer-info-helper-text" rows="6" class="wt-textarea wt-textarea" style="height: 78.6667px !important;"></textarea></div><div id="field-gpsrSafetyWarnings" class="wt-mt-md-6 wt-mt-xs-4"><label for="gspr-safety-warnings-textarea" class="wt-label wt-mb-xs-0">Product safety info</label><p id="gspr-safety-warnings-helper-text" class="wt-text-caption wt-display-block wt-mb-xs-1">Make sure you include any safety details buyers should know like age restrictions, potential hazards, disposal instructions, etc.</p><textarea name="gpsrSafetyWarnings" id="gspr-safety-warnings-textarea" aria-invalid="false" aria-required="false" aria-describedby="gspr-safety-warnings-helper-text" rows="6" class="wt-textarea wt-textarea" style="height: 78.6667px !important;"></textarea></div></div></div></div></div><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" id="how-its-made" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><div><h2 class="wt-text-title-large">How it's made</h2><p class="wt-text-caption wt-sem-text-secondary">We want to know more about how your item was made, and so do buyers. This helps to show what makes your item special, and helps the Etsy marketplace stay unique. <a href="https://www.etsy.com/legal/sellers/?ref=list#selling" target="_blank" rel="noopener noreferrer" class="wt-text-link">Learn more about what types of items are allowed on Etsy.</a></p></div><p class="wt-text-caption pt-xs-2"><strong>We pre-filled some fields for you to review and edit, based on your other listings.</strong></p><div id="field-whoMade" class="wt-mt-md-7 wt-mt-xs-5"><fieldset aria-invalid="false"><legend class="wt-label wt-mb-xs-1">Who made it? <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></legend><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-b487ce4a-f15b-4cdb-b8e0-eccdfd7b36e9" name="whoMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" aria-checked="true"><label for="wt-radio-b487ce4a-f15b-4cdb-b8e0-eccdfd7b36e9">I did</label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-8e7d57e3-984d-4ec6-bc6d-33dbf02f17e5" name="whoMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1"><label for="wt-radio-8e7d57e3-984d-4ec6-bc6d-33dbf02f17e5">A member of my shop</label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-683f5f8a-09a4-486b-8ffa-d6c9e4531350" name="whoMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1"><label for="wt-radio-683f5f8a-09a4-486b-8ffa-d6c9e4531350">Another company or person</label></div></fieldset></div><div id="field-isSupply" class="wt-mt-md-6 wt-mt-xs-4"><fieldset aria-invalid="false"><legend class="wt-label wt-mb-xs-1">What is it? <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></legend><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-c41262fb-7fd3-47ad-96fe-492a27b38f14" name="isSupply" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1"><label for="wt-radio-c41262fb-7fd3-47ad-96fe-492a27b38f14">A finished product</label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-5fadc78e-3d54-4b85-bc40-0455a6a35e03" name="isSupply" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" aria-checked="true"><label for="wt-radio-5fadc78e-3d54-4b85-bc40-0455a6a35e03">A supply or tool to make things</label></div></fieldset></div><fieldset class="wt-mt-md-6 wt-mt-xs-4"><legend class="wt-label wt-mb-xs-1">How does your shop produce this item?</legend><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-5edb61a8-093c-432f-b8bd-1b3bd361c2fe" name="howMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" value="from_scratch"><label for="wt-radio-5edb61a8-093c-432f-b8bd-1b3bd361c2fe"><p class="wt-text-title">It's made from scratch</p><p class="wt-text-body-small wt-sem-text-secondary">My shop makes this item using only raw or basic craft materials, such as fabric, clay, resin, glass, etc.</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1 wt-mb-xs-3">Examples: A chair made from wood; ceramic pottery thrown on a wheel.</p></label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-fc9e0ebb-357c-4e5e-b815-c319569b80ec" name="howMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" value="assembled"><label for="wt-radio-fc9e0ebb-357c-4e5e-b815-c319569b80ec"><p class="wt-text-title">It's assembled from purchased parts</p><p class="wt-text-body-small wt-sem-text-secondary">My shop assembles this item using some commercially available supplies, components, or parts, such as jewellery charms, patches, etc.</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1 wt-mb-xs-3">Examples: A necklace chain with jewellery charms attached; a denim jacket with patches sewn on.</p></label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-f27eee8c-b46d-45ba-8648-0f15fca78251" name="howMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" value="altered"><label for="wt-radio-f27eee8c-b46d-45ba-8648-0f15fca78251"><p class="wt-text-title">It's an item that my shop alters</p><p class="wt-text-body-small wt-sem-text-secondary">My shop alters or customises a commercially available base item, such as a t-shirt or mug.</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1 wt-mb-xs-3">Examples: A tote bag with flowers embroidered on it; a piece of furniture reupholstered with new fabric; a tumbler with a laser engraved design.</p></label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-d436c72e-d086-4817-90d8-df51decbf0a9" name="howMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" value="curated"><label for="wt-radio-d436c72e-d086-4817-90d8-df51decbf0a9"><p class="wt-text-title">It's a curated set of purchased goods</p><p class="wt-text-body-small wt-sem-text-secondary">My shop curates a themed assortment that includes some commercially available goods.</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1 wt-mb-xs-3">Examples: A spa kit that contains a candle, face mask, herbal tea, and other goods curated by my shop; a father’s day gift basket with a chocolate bar, tumbler, notebook, and other goods curated by my shop.</p></label></div><div data-clg-id="WtCheckable" class="wt-mt-xs-1 wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-35b86fe3-d2a7-48a3-be6e-123f6dfd2f2a" name="howMade" data-clg-id="WtRadio" role="radio" class="wt-mt-xs-1" value="natural"><label for="wt-radio-35b86fe3-d2a7-48a3-be6e-123f6dfd2f2a"><p class="wt-text-title">It's a natural material</p><p class="wt-text-body-small wt-sem-text-secondary">My shop finds or cultivates this item from nature.</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1 wt-mb-xs-3">Examples: Crystals, plants, shells, etc.</p></label></div></fieldset><fieldset class="wt-mt-md-6 wt-mt-xs-4"><legend class="wt-label wt-mb-xs-2">What tools are used to make this item?<p class="wt-text-body wt-sem-text-secondary">Select all that apply.</p></legend><div data-clg-id="WtCheckable" class="wt-mb-xs-2 wt-checkbox"><input type="checkbox" id="wt-checkbox-580c0539-ef9d-48eb-aafa-56c7667c061f" name="whatTools" data-clg-id="WtCheckbox" role="checkbox" class="wt-mb-xs-2"><label for="wt-checkbox-580c0539-ef9d-48eb-aafa-56c7667c061f"><p class="wt-text-title">Handheld or hand-guided tools</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1">Examples: sewing needles, paintbrush, sewing machine, table saw, etc.</p></label></div><div data-clg-id="WtCheckable" class="wt-mb-xs-2 wt-checkbox"><input type="checkbox" id="wt-checkbox-1eb29dd7-da49-4525-bd66-07cde7437e1b" name="whatTools" data-clg-id="WtCheckbox" role="checkbox" class="wt-mb-xs-2"><label for="wt-checkbox-1eb29dd7-da49-4525-bd66-07cde7437e1b"><p class="wt-text-title">Computerised tools or machines</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1">Examples: laser printer, computerised embroidery machine, Cricut machine, CNC machine, 3D printer, etc.</p></label></div><div data-clg-id="WtCheckable" class="wt-mb-xs-2 wt-checkbox"><input type="checkbox" id="wt-checkbox-bf129989-06bc-4f91-bf12-d858d3c88fa3" name="whatTools" data-clg-id="WtCheckbox" role="checkbox" class="wt-mb-xs-2" aria-checked="true"><label for="wt-checkbox-bf129989-06bc-4f91-bf12-d858d3c88fa3"><p class="wt-text-title">An AI generator</p><p class="wt-text-body-small wt-sem-text-secondary wt-line-height-tight wt-mt-xs-1">Examples: Midjourney, DALL-E, Canva AI, Chat-GPT, etc.</p></label></div><div data-clg-id="WtCheckable" class="wt-mb-xs-2 wt-checkbox"><input type="checkbox" id="wt-checkbox-f319b502-a770-4df5-a2d9-3b66c327c472" name="whatTools" data-clg-id="WtCheckbox" role="checkbox" class="wt-mb-xs-2"><label for="wt-checkbox-f319b502-a770-4df5-a2d9-3b66c327c472"><p class="wt-text-title">None, I don't use tools</p></label></div></fieldset><div id="field-productionPartnerIds" class="wt-mt-md-6 wt-mt-xs-4"><div><div data-clg-id="WtGrid" class="wt-p-xs-3 wt-b-xs wt-rounded-02 wt-overflow-hidden wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" class="wt-display-flex-xs wt-align-items-center wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-lg-7"><p class="wt-text-title-01">Production partners for this listing</p><p class="wt-text-caption wt-mt-xs-1 wt-pr-xs-2">A production partner is anyone who’s not a part of your Etsy shop who helps you physically produce your items. <a data-clg-id="WtTextLink" target="_blank" href="https://help.etsy.com/hc/en-us/articles/360000336547-Working-with-Production-Partners-and-How-We-Review-Them?ref=seller-platform" class="wt-text-link">Is this required for you?<span class="wt-screen-reader-only">Opens a new tab</span></a></p></div><div data-clg-id="WtGridItem" class="wt-display-flex-lg wt-justify-content-flex-end wt-grid__item-xs-12 wt-grid__item-lg-5"><div class="wt-display-flex-xs wt-align-items-center wt-pt-xs-3 wt-pt-lg-0"><button type="button" aria-controls="production-partners-overlay" data-clg-id="WtButton" class="wt-btn wt-btn--secondary wt-display-flex-xs wt-no-wrap wt-align-items-center"><span class="wt-mr-xs-1 etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.696 2.5A1 1 0 0 1 13.694 3.553L13.32 10.68 20.447 10.306A1 1 0 0 1 21.5 11.304V12.696A1 1 0 0 1 20.447 13.694L13.32 13.32 13.694 20.447A1 1 0 0 1 12.696 21.5H11.304A1 1 0 0 1 10.306 20.447L10.68 13.32 3.553 13.694A1 1 0 0 1 2.5 12.696V11.304A1 1 0 0 1 3.553 10.306L10.68 10.68 10.306 3.553A1 1 0 0 1 11.304 2.5z"></path></svg></span>Add production partners</button></div></div></div></div></div></div></div></div></div></div><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" id="settings" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><div><h2 class="wt-text-title-large">Settings</h2><p class="wt-text-caption wt-sem-text-secondary">Choose how this listing will display in your shop, how it will renew, and if you want it to be promoted in Etsy Ads.</p></div><p class="wt-text-caption pt-xs-2"><strong>We pre-filled some fields for you to review and edit, based on your other listings.</strong></p><div id="field-sectionId" class="wt-mt-md-7 wt-mt-xs-5"><label for="shop-section-select" class="wt-label wt-mb-xs-0">Shop section </label><p id="listing-section-helper-text" class="wt-text-caption wt-display-block wt-mb-xs-1">Use shop sections to organise your products into groups shoppers can explore.</p><div data-clg-id="WtGrid" class="wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-9 wt-grid__item-sm-6 wt-grid__item-md-5 wt-grid__item-lg-6 wt-grid__item-xl-5 wt-grid__item-tv-4"><div data-clg-id="WtSelect" class="wt-select"><select id="shop-section-select" aria-describedby="listing-section-helper-text" class="wt-select__element"><option value="0">None</option><optgroup label="Select a section"><option value="58627488">JAPANDI</option><option value="58658071">SUMMER/4TH OF JULY</option><option value="58676906">ANIMAL</option><option value="58704950">MASCULINE/FEMININE</option><option value="58731702">FLORAL/BOTANICAL</option><option value="58765776">FRAME TV ART</option><option value="58867969">CUSTOM</option><option value="59052080">DARK ACADEMIA/ HALLOWEEN</option><option value="59116299">FARMHOUSE/KITCHEN</option></optgroup><optgroup label="Couldn't find a section?"><option value="1">Add a section</option></optgroup></select></div></div></div></div><fieldset id="field-featuredRank" class="wt-mt-md-6 wt-mt-xs-4 wt-grid__item-xs-12 wt-grid__item-xl-11 wt-grid__item-tv-10"><div class="wt-display-inline-block wt-display-flex-sm wt-justify-content-space-between"><legend class="wt-label">Feature this listing <span class="wt-text-caption wt-display-block">Showcase this listing at the top of your shop home to make it stand out.</span></legend><div data-clg-id="WtSwitch" class="wt-switch__wrapper wt-mt-xs-2 wt-mt-sm-0"><div class="wt-switch__frame"><input type="checkbox" id="listing-featured-rank-checkbox" class="wt-switch wt-switch--small"><label for="listing-featured-rank-checkbox" class="wt-switch__toggle"><span class="wt-screen-reader-only">Feature this listing</span></label></div></div></div></fieldset><fieldset id="field-shouldAdvertise" class="wt-mt-md-6 wt-mt-xs-4 wt-grid__item-xs-12 wt-grid__item-xl-11 wt-grid__item-tv-10"><div class="wt-display-inline-block wt-display-flex-sm wt-justify-content-space-between"><label for="listing-is-promoted-checkbox" class="wt-label">Etsy Ads <span class="wt-text-caption wt-display-block">Promote this listing on Etsy as part of your Etsy Ads campaign.</span></label><div><div data-clg-id="WtSwitch" class="wt-switch__wrapper wt-mt-xs-2 wt-mt-sm-0"><div class="wt-switch__frame"><input type="checkbox" id="listing-is-promoted-checkbox" class="wt-switch wt-switch--small"><label for="listing-is-promoted-checkbox" class="wt-switch__toggle"><span class="wt-screen-reader-only">Promote this listing on Etsy as part of your Etsy Ads campaign.</span></label></div></div></div></div></fieldset><div id="field-shouldAutoRenew" class="wt-mt-md-6 wt-mt-xs-4"><fieldset><legend class="wt-label">Renewal options <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></legend><p id="listing-renewal-options-helper-text" class="wt-text-caption">Each renewal lasts for four months or until the listing sells out. <button type="button" class="wt-text-link">Get more details on auto-renewing.</button></p><div class="wt-mt-xs-3"><div data-clg-id="WtCheckable" class="wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-532c3e61-3a1e-41bf-8db4-84f9b2578e9f" name="shouldAutoRenew" aria-checked="true" data-clg-id="WtRadio" role="radio"><label for="wt-radio-532c3e61-3a1e-41bf-8db4-84f9b2578e9f" class="wt-text-title-01">Automatic<span class="wt-text-caption wt-display-block">This listing will renew as it expires for USD 0.20 USD each time (recommended).</span></label></div><div class="wt-mt-xs-2"><div data-clg-id="WtCheckable" class="wt-radio wt-radio--position-start wt-radio--align-top"><input type="radio" id="wt-radio-7f9af559-22b0-4ed7-a0f2-4c9e7840bc75" name="shouldAutoRenew" data-clg-id="WtRadio" role="radio"><label for="wt-radio-7f9af559-22b0-4ed7-a0f2-4c9e7840bc75" class="wt-text-title-01">Manual<span class="wt-text-caption wt-display-block">I'll renew expired listings myself.</span></label></div></div></div></fieldset></div></div></div></div></div></div><div id="form-footer" class="le-form__footer wt-bt-xs wt-pl-xs-4 wt-pr-xs-4 wt-pb-xs-3 wt-pt-xs-3 wt-position-sticky wt-position-bottom wt-sem-bg-elevation-0 z-index-3"><div class="wt-display-flex-xs wt-flex-direction-column-xs wt-flex-direction-row-lg wt-justify-content-space-between wt-align-items-center wt-width-full-xs wt-width-auto-lg wt-body-max-width wt-pr-xs-2 wt-pr-lg-6 wt-pl-xs-2 wt-pl-lg-6"><div class="wt-width-full-xs wt-width-auto-lg wt-pr-lg-6 wt-pb-xs-4 wt-pb-lg-0"><p data-error-summary="true" class="wt-sem-text-critical wt-text-title">Please fix the following error in order to save your changes:</p><a href="/your/shops/me/listing-editor/create#pricing-logistics/field-returnPolicyId" class="wt-text-body-01 wt-text-link">Returns and exchanges</a></div><div class="le-footer__actions wt-display-flex-xs wt-flex-direction-row-lg wt-no-wrap wt-flex-direction-column-xs wt-flex-grow-xs-1 wt-justify-content-flex-end wt-width-full-xs wt-width-auto-lg"><a type="button" data-testid="cancel" data-clg-id="WtButton" href="/your/shops/me/tools/listings" class="wt-btn wt-btn--transparent">Cancel</a><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--outline" disabled="" aria-disabled="true">Preview</button><button type="button" id="shop-manager--listing-save" data-testid="save" data-clg-id="WtButton" class="wt-btn wt-btn--outline">Save as draft</button><button type="button" data-testid="publish" data-clg-id="WtButton" class="wt-btn wt-btn--primary" disabled="" aria-disabled="true">Publish</button></div></div></div></div></form></div></div></main></div>
