+            "low": conditions[1],
+            "medium": conditions[2],
+            "high": conditions[3],
+            "mixed": conditions[4],
+        }
+        
+        c = mode_map[args.mode]
+        print(f"=== TESTING CONDITION: {c['name']} ===")
+        win_rate, avg_dist = run_test_loop(
