0 16.71 11.47z"></path></svg></span></li><li><span aria-current="page" class="wt-text-body-small wt-sem-text-primary">New listing</span></li></ol></nav><div class="wt-display-flex-xs wt-flex-direction-column-xs"><div class="wt-display-flex-xs wt-justify-content-space-between wt-align-items-center"><div class="wt-display-flex-xs wt-align-items-center"><h3 class="wt-text-title-large wt-pt-xs-2 wt-pt-lg-3 wt-pb-xs-2 wt-pb-lg-3">New listing</h3></div><div class="wt-display-flex-xs wt-align-items-center"><div class="wt-display-flex-xs wt-flex-gap-xs-1"></div></div></div></div></header></div><div id="tabs-menu-container" class="wt-bg-white wt-position-sticky wt-position-top z-index-3"><nav data-clg-id="WtExternalTabList" aria-label="Listing form tabs" class="wt-tab-container le-tab le-display-inline-flex-xs le-display-block-sm wt-body-max-width wt-pr-xs-2 wt-pr-lg-6 wt-pl-xs-2 wt-pl-lg-6"><ul class="wt-tab"><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3"><a href="/your/shops/me/listing-editor/create#media"><span>Photo &amp; Video</span></a></li><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3 wt-ml-xs-3"><a href="/your/shops/me/listing-editor/create#category"><span>Category</span></a></li><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3 wt-ml-xs-3"><a href="/your/shops/me/listing-editor/create#item-details"><span>Item Details</span></a></li><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3 wt-ml-xs-3"><a href="/your/shops/me/listing-editor/create#item-options"><span>Item Options</span></a></li><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3 wt-ml-xs-3"><a href="/your/shops/me/listing-editor/create#pricing-logistics"><span>Pricing &amp; Delivery</span></a></li><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3 wt-ml-xs-3 wt-tab__item--selected"><a href="/your/shops/me/listing-editor/create#how-its-made" aria-current="page"><span class="wt-text-denim-light le-font-bold">How It's Made</span></a></li><li data-clg-id="WtExternalTab" class="wt-tab__item wt-mr-xs-3 wt-ml-xs-3"><a href="/your/shops/me/listing-editor/create#settings"><span>Settings</span></a></li></ul></nav></div><div class="wt-justify-content-center wt-pt-xs-1 wt-pt-md-2 wt-pb-xs-4"><div data-clg-id="WtGrid" class="wt-body-max-width wt-pr-xs-2 wt-pr-lg-6 wt-pl-xs-2 wt-pl-lg-6 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" id="media" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><div><h2 class="wt-text-title-large">Photo and video</h2><p class="wt-text-caption wt-sem-text-secondary">Show off different angles, available options, or even a peek behind the scenes at your process.</p></div><div id="field-listingImages" class="wt-mt-md-6 wt-mt-xs-4"><div data-media-header="true" class="wt-mb-xs-1 wt-align-items-center wt-display-flex-xs wt-justify-content-space-between"><label for="listing-photos" class="wt-label">Add up to 20 photos and 2 videos. <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span><div data-clg-id="WtPopoverControlled" class="wt-popover"><button type="button" aria-describedby="popover-content-ac2fe4d8-d7de-411f-81c8-a486123a2f90" aria-label="Help" class="wt-popover__trigger wt-text-body-01"><span class="wt-mr-xs-1 wt-nudge-b-1 wt-icon--base-xs etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.059 17H10.677V14.744H13.059zM12.195 7C14.034 7 15.398 8.045 15.398 9.744 15.398 10.747 14.828 11.568 14.173 12.056L13.602 12.5C13.058 12.919 12.878 13.254 12.878 13.951H10.858C10.858 12.626 11.178 12.013 12.056 11.358L12.585 10.983C13.058 10.635 13.268 10.26 13.268 9.827 13.268 9.16 12.822 8.755 12.14 8.755 11.276 8.755 10.774 9.285 10.774 10.356H8.602C8.602 8.31 9.995 7 12.195 7"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C17.523 2 22 6.477 22 12S17.523 22 12 22 2 17.523 2 12 6.477 2 12 2M12 4.5A7.5 7.5 0 1 0 12 19.5 7.5 7.5 0 0 0 12 4.5"></path></svg></span></button><div role="tooltip" id="popover-content-ac2fe4d8-d7de-411f-81c8-a486123a2f90"><h3 class="wt-text-caption-title wt-mb-xs-2">Photo requirements</h3><ul class="wt-list wt-text-caption"><li>Use a JPG, GIF, or PNG.</li><li>The recommended size is 2000px for the shortest side, and a resolution of 72PPI.</li><li>Keep it under 1MB for faster uploading.</li></ul><p class="wt-mb-xs-2 wt-mt-xs-2 wt-text-caption">Find more details and best practices for photography in <a href="https://help.etsy.com/hc/en-us/articles/115015663347-Requirements-and-Best-Practices-for-Images-in-Your-Etsy-Shop?segment=selling" class="wt-text-link" target="_blank">this help article</a>.</p><h3 class="wt-text-caption-title wt-mb-xs-2 wt-mt-xs-2">Listing videos</h3><ul class="wt-list wt-text-caption"><li>Most file types are accepted.</li><li>Max file size is 100MB.</li><li>Can be 3-15 seconds long. If you upload a longer video (up to 60 seconds), we'll automatically trim it to the first 15 seconds.</li><li>Keep in mind, your video won't include audio.</li></ul><p class="wt-mb-xs-2 wt-mt-xs-2 wt-text-caption">Find more info on file types and formatting your video in <a href="https://help.etsy.com/hc/en-us/articles/360053206073-How-to-Add-a-Listing-Video?segment=selling" class="wt-text-link" target="_blank">this help article</a>.</p><span class="wt-popover__arrow"></span></div></div></label></div><div data-clg-id="WtUploadArea" class="wt-upload__area wt-z-index-1"><div class="wt-width-full wt-mt-xs-2 wt-p-xs-4 wt-display-flex-xs wt-flex-direction-column-xs wt-flex-gap-xs-1 wt-justify-content-center wt-align-items-center"><p class="wt-text-body-01"><strong>Drag and drop files or</strong></p><div class="wt-position-relative z-index-10 le-video-multiple-upload-area"><button type="button" data-clg-id="WtButton" class="wt-btn wt-btn--tertiary wt-mt-xs-1"><span class="wt-nudge-b-2 etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.696 2.5A1 1 0 0 1 13.694 3.553L13.32 10.68 20.447 10.306A1 1 0 0 1 21.5 11.304V12.696A1 1 0 0 1 20.447 13.694L13.32 13.32 13.694 20.447A1 1 0 0 1 12.696 21.5H11.304A1 1 0 0 1 10.306 20.447L10.68 13.32 3.553 13.694A1 1 0 0 1 2.5 12.696V11.304A1 1 0 0 1 3.553 10.306L10.68 10.68 10.306 3.553A1 1 0 0 1 11.304 2.5z"></path></svg></span><span class="wt-ml-xs-1">Upload</span></button><input type="file" multiple="" class="wt-display-none"></div></div><div data-clg-id="WtUploadBackdrop" class="wt-upload__backdrop wt-display-none"><div data-clg-id="WtUploadDropIndicator" class="wt-upload__drop-indicator__frame"><div class="wt-upload__drop-indicator"><span class="wt-nudge-b-1 wt-nudge-r-3 wt-icon--smaller etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.715 9.413A.5.5 0 0 1 18.715 10.12L18.607 10.228A.5.5 0 0 1 18.05 10.332L13.142 8.149 13.927 19.933A1 1 0 0 1 12.93 21H11.068A1 1 0 0 1 10.07 19.933L10.856 8.151 5.95 10.33A.5.5 0 0 1 5.393 10.229L5.283 10.118A.5.5 0 0 1 5.283 9.41L11.429 3.266A.75.75 0 0 1 11.96 3.047H12.04C12.237 3.047 12.429 3.126 12.569 3.267z"></path></svg></span> Add file</div></div></div></div></div></div></div></div><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12"><div data-clg-id="WtGrid" id="category" class="wt-bg-white wt-b-xs le-rounded-02 wt-p-xs-3 wt-p-md-5 wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-tv-8"><div><h2 class="wt-text-title-large">Category</h2><p class="wt-text-caption wt-sem-text-secondary"></p></div><p class="wt-text-caption"><strong>We pre-filled some fields for you to review and edit, based on your other listings.</strong></p><div id="field-category" class="wt-mt-md-7 wt-mt-xs-5"><div><label for="category-field-search" class="wt-text-title wt-pb-xs-1">Find a category <span data-testid="required-badge" aria-hidden="true" data-required-text="Required" class="wt-label__required"></span></label></div><div><div class="le-category-search wt-position-relative"><div class="le-category-search__input wt-input__prepend-wrapper"><span id="addon-d491caef-d1d6-473e-893d-de1579228a17" class="wt-input__prepend"><span class="etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 1.5A8.5 8.5 0 0 1 17.118 14.642L21.555 18.337A2.284 2.284 0 1 1 18.339 21.554L14.643 17.118A8.5 8.5 0 1 1 10 1.5M10 5A5 5 0 1 0 10 15 5 5 0 0 0 10 5"></path></svg></span><span class="wt-screen-reader-only"></span></span><input data-clg-id="WtInput" type="text" aria-describedby="" id="category-field-search" aria-invalid="false" aria-expanded="false" aria-activedescendant="" aria-controls="category-search-options-cd0d4074-f296-41a0-90bc-a4bc4a19e6b9" role="combobox" aria-autocomplete="list" autocomplete="off" placeholder="Examples: Engagement Rings, Scatter Cushions, Pet Costumes" class="wt-input wt-pl-xs-7"></div><button type="button" aria-label="Clear" data-clg-id="WtButton" class="wt-btn wt-btn--transparent wt-btn wt-position-absolute wt-position-right wt-nudge-t-2 wt-p-xs-2 wt-mr-xs-2 wt-animated wt-animated--disappear-01 wt-btn--small" value="Clear"><span class="wt-icon--smaller-xs etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.836 3.768A1 1 0 0 1 19.286 3.73L20.27 4.714A1 1 0 0 1 20.232 6.164L13.742 12 20.232 17.836A1 1 0 0 1 20.27 19.286L19.287 20.27A1 1 0 0 1 17.836 20.232L12 13.742 6.165 20.232A1 1 0 0 1 4.713 20.27L3.73 19.287A1 1 0 0 1 3.768 17.836L10.258 12 3.767 6.165A1 1 0 0 1 3.73 4.714L4.713 3.73A1 1 0 0 1 6.165 3.768L12 10.258z"></path></svg></span></button><div aria-hidden="true" class="wt-panel__frame wt-panel__frame--anchored le-category-search__panel wt-overflow-hidden"><ul data-clg-id="WtOptionGroup" id="category-search-options-cd0d4074-f296-41a0-90bc-a4bc4a19e6b9" role="listbox" class="wt-options le-options" style="min-width: 844px; width: 844px; max-width: 844px;"></ul></div></div></div><div data-clg-id="WtAnnouncement" role="status" aria-atomic="false" class="wt-screen-reader-only"></div><div data-clg-id="WtGrid" class="wt-panel wt-align-items-center wt-p-xs-3 wt-position-relative wt-mt-xs-2 wt-grid"><div data-clg-id="WtGridItem" class="wt-grid__item-xs-12 wt-grid__item-md-9"><h2 class="wt-text-title">Digital Prints</h2><div class="wt-line-height-tight wt-break-word wt-text-body-small"><span data-test-id="seller-taxonomy-path-name">Art &amp; Collectibles</span><span class="etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10.707 8C10.895 8 11.074 8.074 11.207 8.207L14.47 11.47A.75.75 0 0 1 14.47 12.53L11.207 15.793A.708.708 0 0 1 10 15.293V8.707C10 8.317 10.317 8 10.707 8"></path></svg></span><span data-test-id="seller-taxonomy-path-name">Prints</span><span class="etsy-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10.707 8C10.895 8 11.074 8.074 11.207 8.207L14.47 11.47A.75.75 0 0 1 14.47 12.53L11.207 15.793A.708.708 0 0 1 10 15.293V8.707C10 8.317 10.317 8 10.707 8"></path></svg></span><span data-test-id="seller-taxonomy-path-name">Digital Prints</span></div><p data-testid="buyer-categories" class="wt-text-body-small wt-pt-xs-2 wt-line-height-tight">This listing will appear in 7 related categories, including <strong>Home &amp; Living</strong>, <strong>Home Decor</strong> and more.</p></div></div><div class="wt-pb-xs-2"></div></div><div id="field-listingType" class="wt-mt-md-6 wt-mt-xs-4"><div id="field-listingType"><fieldset data-clg-id="WtActionGroupSelectable"><legend class="wt-label wt-label wt-mb-xs-2">What type of item is it? <span data-testid="required-badge" 