+++ b/run_daily_batch.py
@@ -0,0 +1,89 @@
+import os
+import sys
+import time
+import subprocess
+
+# Default today's 4 design folders if none provided
+DEFAULT_FOLDERS = [
+    # MutedBloom (Profile 7)
+    r"D:\etsy\535\output\ChatGPT Image Jul 21, 2026, 11_11_29 AM",
+    r"D:\etsy\535\output\ChatGPT Image Jul 21, 2026, 11_23_07 AM",
+    # WillowPrintsCo (Profile 11)
+    r"D:\etsy2\4\output\willow",
+    r"D:\etsy2\4\output\willow 2"
+]
+
+def main():
+    print("=" * 65)
+    print("      DAILY ETSY BATCH LISTER (4 DESIGNS IN 1-CLICK)")
+    print("=" * 65)
+    print()
+    print("Today's Default Batch:")
+    print("  [MutedBloom - Profile 7]")
+    print(f"   1. {DEFAULT_FOLDERS[0]}")
+    print(f"   2. {DEFAULT_FOLDERS[1]}")
+    print("  [WillowPrintsCo - Profile 11]")
+    print(f"   3. {DEFAULT_FOLDERS[2]}")
+    print(f"   4. {DEFAULT_FOLDERS[3]}")
+    print("=" * 65)
+    print()
+
+    user_input = input("Press ENTER for today's 4 default folders\nOR drag & drop folder(s) here\nOR type 'custom' to specify how many: ").strip()
+    
+    folders_to_run = DEFAULT_FOLDERS
+    if user_input:
+        cleaned_input = user_input.replace('"', '').strip()
+        if os.path.exists(cleaned_input):
+            folders_to_run = [cleaned_input]
+        elif user_input.lower() == "custom":
+            try:
+                count_str = input("How many folders do you want to list today? ").strip()
+                count = int(count_str)
+            except:
+                count = 4
+            custom_folders = []
+            print(f"\nEnter {count} folder paths below (drag & drop or paste):")
+            for i in range(1, count + 1):
+                path = input(f" Folder {i}: ").strip().replace('"', '')
+                if path and os.path.exists(path):
+                    custom_folders.append(path)
+            if custom_folders:
+                folders_to_run = custom_folders
+
+    print(f"\nStarting Batch Listing Process for {len(folders_to_run)} Design(s)...\n")
+    
+    bot_script = r"E:\github proj\my_drone_rl\etsy_listing_bot.py"
+    
+    for idx, folder in enumerate(folders_to_run, 1):
+        if not os.path.exists(folder):
+            print(f"[{idx}/4] ERROR: Folder '{folder}' does not exist! Skipping...")
+            continue
+
+        # Auto-detect profile directory
+        profile_dir = "Profile 7"
+        if "etsy2" in folder.lower() or "willow" in folder.lower():
+            profile_dir = "Profile 11"
+
+        print(f"\n=======================================================")
+        print(f" RUNNING LISTING [{idx}/4]")
+        print(f" Folder:  {folder}")
+        print(f" Profile: {profile_dir} ({'WillowPrintsCo' if profile_dir == 'Profile 11' else 'MutedBloom'})")
+        print(f"=======================================================\n")
+
+        # Run the etsy_listing_bot.py synchronously for this folder using sys.executable
+        res = subprocess.run([sys.executable, bot_script, folder, profile_dir])
+
+        if res.returncode == 0:
+            print(f"\n✅ Finished [{idx}/4] successfully!")
+        else:
+            print(f"\n⚠️ Warning: Listing [{idx}/4] exited with code {res.returncode}")
+
+        print("Pausing 3 seconds before next listing...\n")
+        time.sleep(3)
+
+    print("=" * 65)
+    print("   🎉 ALL 4 DAILY LISTINGS COMPLETED SUCCESSFULLY!")
+    print("=" * 65)
+
+if __name__ == "__main__":
+    main()
diff --git a/run_listing.bat b/run_listing.bat
new file mode 100644
index 0000000..b1f706b
--- /dev/null
+++ b/run_listing.bat
@@ -0,0 +1,46 @@
+@echo off
+title Etsy Listing Automator
+echo ============================================================
+echo               ETSY LISTING AUTOMATOR
+echo ============================================================
+echo.
+
+:: Get the folder path
+set "TARGET_FOLDER=%~1"
+
+if "%TARGET_FOLDER%"=="" (
+    echo [ERROR] No folder was selected.
+    echo Please drag-and-drop a design folder onto this batch file,
+    echo or paste the full folder path below:
+    set /p "TARGET_FOLDER=Folder Path: "
+)
+
+:: Clean up quotes
+set "TARGET_FOLDER=%TARGET_FOLDER:"=%"
+
+if not exist "%TARGET_FOLDER%" (
+    echo [ERROR] Folder "%TARGET_FOLDER%" does not exist!
+    echo.
+    pause
+    exit /b
+)
+
+echo Target Folder: %TARGET_FOLDER%
+echo.
+echo [1/3] Closing any active Thorium windows to reset locks...
+taskkill /F /IM thorium.exe >nul 2>&1
+timeout /t 2 /nobreak >nul
+
+echo [2/3] Preparing script execution...
+timeout /t 1 /nobreak >nul
+
+echo [3/3] Running automation...
+cd /d "E:\github proj\my_drone_rl"
+conda run -n drone_fyp python etsy_listing_bot.py "%TARGET_FOLDER%"
+
+echo.
+echo ============================================================
+echo Automation complete!
+echo ============================================================
+echo.
+pause
