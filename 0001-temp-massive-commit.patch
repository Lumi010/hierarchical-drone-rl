+def go_to_tab(page, tab_name):
+    print(f"Navigating to tab: {tab_name}...")
+    try:
+        # Wait up to 10 seconds for tab elements to appear on page load
+        try:
+            page.locator("a, button, [role='tab']").first.wait_for(state="visible", timeout=10000)
+        except:
+            pass
+
+        # Try finding the tab by checking text content and length
+        # This matches "Category *" or "Category" but excludes long helper buttons (like "Change category anyway")
+        tab = None
+        tabs = page.locator("a, button, [role='tab']")
+        for i in range(tabs.count()):
+            t = tabs.nth(i)
+            t_text = t.inner_text().strip().lower()
+            if tab_name.lower() in t_text and len(t_text) <= len(tab_name) + 5:
+                tab = t
+                break
+        
+        if tab and tab.count():
+            try:
+                tab.wait_for(state="visible", timeout=5000)
+            except:
+                pass
+            tab.click(force=True)
+            time.sleep(3)
+            return True
+    except Exception as e:
+        print(f"Warning: Could not navigate to tab {tab_name}: {e}")
+    return False
